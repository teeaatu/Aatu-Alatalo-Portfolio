---
import { ClientRouter } from "astro:transitions";
import CreativeToolbar from '../components/creative/CreativeToolbar.astro';
import {
  CATEGORIES,
  canonicalPath,
  getCategoryLabel,
  getCategoryUrl,
  parseLocalizedField,
  resolveImagePaths,
  type Lang,
} from '../utils/gallery-config';

const {
  lang = 'fi',
  dataset = [],
  categoryTitle = '',
  categorySlug = '',
  activeNav = '',
  translationUrl = '',
  nextUrl = '',
  prevUrl = '',
  title,
  description,
} = Astro.props;

const activeLang: Lang = lang === 'en' ? 'en' : 'fi';
const siteUrl = 'https://aatualatalo.com';
const pageTitle = title || (categoryTitle ? `${categoryTitle} — Aatu Alatalo` : 'Aatu Alatalo | Valokuvaaja');
const mainDesc = description || (activeLang === 'fi'
  ? 'Aatu Alatalo (s. 25. tammikuuta 2005, Tyrnävä) on Oulussa asuva valokuvaaja ja Hasselblad Masters 2026 -finalisti.'
  : 'Aatu Alatalo is a photographer from Tyrnävä, based in Oulu, Finland, and a Hasselblad Masters 2026 finalist.');

let jdIdx = 0;
const galleryData: any[] = [];
for (const item of dataset) {
  const titleVal = item.otsikko || '';
  const placeVal = item.paikka || '';
  const textVal = item.teksti || '';

  if (item.tyyppi === 'teksti') {
    if (categorySlug !== 'work1') continue;
    galleryData.push({
      i: jdIdx++,
      type: 'text',
      title: parseLocalizedField(titleVal, activeLang),
      text: parseLocalizedField(textVal, activeLang),
      series: item.series || 'all',
      kartta: item.kartta || null,
    });
    continue;
  }
  if (item.layout === 'diptych' && item.images) {
    const images = item.images.map((sub: any) => {
      const { src, srcAvif, srcMob, full } = resolveImagePaths(sub.kuva);
      return {
        src,
        srcAvif,
        srcset: `${srcMob} 800w, ${src} 1600w, ${full} 3000w`,
        full,
        thumb: srcMob,
        width: sub.width || null,
        height: sub.height || null,
        alt: sub.alt_text || '',
      };
    });
    galleryData.push({
      i: jdIdx++,
      layout: 'diptych',
      images,
      title: parseLocalizedField(titleVal, activeLang),
      place: parseLocalizedField(placeVal, activeLang),
      series: item.series || 'all',
    });
  } else {
    const { src, srcAvif, srcMob, full } = resolveImagePaths(item.kuva);
    galleryData.push({
      i: jdIdx++,
      src,
      srcAvif,
      srcset: `${srcMob} 800w, ${src} 1600w, ${full} 3000w`,
      full,
      thumb: srcMob,
      width: item.width || null,
      height: item.height || null,
      alt: item.alt_text || '',
      title: parseLocalizedField(titleVal, activeLang),
      place: parseLocalizedField(placeVal, activeLang),
      series: item.series || 'all',
    });
  }
}

const hasMap = galleryData.some(item => item.type === 'text' && item.kartta);
const catLabel = getCategoryLabel(categorySlug, activeLang, categoryTitle);
const isEventsCategory = categorySlug === 'tapahtumat';

const indexCounts: Record<string, number> = {};
const catCoverImages: Record<string, string> = {};
for (const cat of CATEGORIES) {
  indexCounts[cat.key] = cat.data?.length || 0;
  const firstItem = cat.data?.find((it: any) => it.kuva || (it.layout === 'diptych' && it.images?.[0]?.kuva));
  if (firstItem) {
    const k = firstItem.kuva || firstItem.images[0].kuva;
    catCoverImages[cat.key] = resolveImagePaths(k).src;
  }
}

const currentIndex = CATEGORIES.findIndex(c => c.key === categorySlug);
let computedNextUrl = nextUrl;
let computedPrevUrl = prevUrl;
let computedNextLabel = '';
let computedPrevLabel = '';

if (currentIndex !== -1) {
  if (!computedNextUrl) {
    // The final project continues to Recent; the first category's back edge stays unchanged.
    const nextCat = CATEGORIES[(currentIndex + 1) % CATEGORIES.length];
    computedNextUrl = getCategoryUrl(nextCat.key, activeLang);
    computedNextLabel = nextCat.label(activeLang);
  }
  if (!computedPrevUrl && currentIndex > 0) {
    const prevCat = CATEGORIES[currentIndex - 1];
    computedPrevUrl = getCategoryUrl(prevCat.key, activeLang);
    computedPrevLabel = prevCat.label(activeLang);
  }
}

const navItems = CATEGORIES.filter(c => c.group === 'primary');
const catNavItems = CATEGORIES.filter(c => c.group === 'category');
const projectNavItems = CATEGORIES.filter(c => c.group === 'project');

function navUrl(item: { key: string }) {
  return getCategoryUrl(item.key, activeLang);
}
function isActive(item: { key: string }) {
  return activeNav === item.key;
}

const currentUrl = Astro.url.pathname;
const canonicalUrl = siteUrl + canonicalPath(currentUrl);
const fiTransUrl = activeLang === 'fi' ? currentUrl : translationUrl;
const enTransUrl = activeLang === 'en' ? currentUrl : translationUrl;
const switchLangUrl = activeLang === 'fi' ? enTransUrl : fiTransUrl;
---
<!DOCTYPE html>
<html lang={lang} translate="no" class="notranslate">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="color-scheme" content="light">
  <meta name="google" content="notranslate">
  <meta name="format-detection" content="telephone=no">

  <style is:inline>
    html.jd-category-arrival:not(.jd-category-revealing) body { background: #000 !important; }
  </style>
  <!-- Only the unprefixed home page negotiates language; explicit URLs keep theirs. -->
  <script is:inline>
    (function() {
      if (window.location.pathname !== '/') return;

      let userChoice;
      try { userChoice = localStorage.getItem('userLangChoice'); } catch (e) {}
      const preferredLanguages = navigator.languages?.length
        ? navigator.languages
        : [navigator.language || ''];
      const primaryLanguage = (preferredLanguages[0] || '').toLowerCase().split('-')[0];
      const browserChoice = primaryLanguage === 'fi' ? 'fi' : 'en';
      const language = userChoice === 'fi' || userChoice === 'en' ? userChoice : browserChoice;
      if (language === 'en') {
        window.location.replace('/en/' + window.location.search + window.location.hash);
      }
    })();

    // Establish the canvas and Safari tint before the first paint.
    (function () {
      var skip = false;
      try {
        skip = !!sessionStorage.getItem('jd_splash_seen') && !new URLSearchParams(location.search).has('splash');
        var navigation = JSON.parse(sessionStorage.getItem('jd-category-arrival') || 'null');
        sessionStorage.removeItem('jd-category-arrival');
        if (skip && navigation
          && navigation.path === location.pathname.replace(/\/$/, '')
          && Date.now() - navigation.started < 30000
          && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.documentElement.classList.add('jd-category-arrival');
          window.jdCategoryArrivalTitle = navigation.title;
        }
      } catch (e) {}
      document.documentElement.classList.add(skip ? 'jd-no-splash' : 'jd-splash-active');
      // Browser canvas is independent of the light gallery and splash history.
      // Every static category load must establish the same mobile chrome theme.
      window.jdSyncBrowserTheme = function () {
        var darkCanvas = window.matchMedia('(max-width: 800px)').matches
          || document.documentElement.classList.contains('jd-category-arrival')
          || (document.documentElement.classList.contains('jd-splash-active')
            && !document.documentElement.classList.contains('jd-splash-revealing'));
        var scheme = darkCanvas ? 'dark' : 'light';
        var colour = darkCanvas ? '#000000' : '#ffffff';
        document.documentElement.style.colorScheme = scheme;
        document.documentElement.style.backgroundColor = colour;
        document.querySelector('meta[name="color-scheme"]')?.setAttribute('content', scheme);
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', colour);
      };
      window.jdSyncBrowserTheme();
      window.matchMedia('(max-width: 800px)').addEventListener('change', window.jdSyncBrowserTheme);
    })();
  </script>
  <ClientRouter fallback="swap" />
  <script>
    import { navigate } from "astro:transitions/client";
    Object.assign(window, { jdNavigateCategory: navigate });

    document.addEventListener('astro:before-swap', event => {
      // Keep the real black curtain across the DOM swap. No snapshot or fade
      // from the router is needed on top of the gallery's own transition.
      event.viewTransition.skipTransition();
      const root = event.newDocument.documentElement;
      root.classList.add('jd-no-splash');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nextTitle = event.info?.title
        || event.newDocument.querySelector('.jd-shutter-title')?.textContent
        || '';
      const title = document.querySelector('.jd-shutter-title');
      if (title) title.textContent = nextTitle;
      Object.assign(window, { jdCategoryArrivalTitle: reduced ? undefined : nextTitle });
      try { sessionStorage.removeItem('jd-category-arrival'); } catch {}
      if (!reduced) root.classList.add('jd-category-arrival');
    });
    document.addEventListener('astro:after-swap', () => {
      const syncTheme = Reflect.get(window, 'jdSyncBrowserTheme');
      if (typeof syncTheme === 'function') syncTheme();
    });
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={mainDesc}>
  <meta name="robots" content="index, follow">
  <link rel="canonical" href={canonicalUrl}>
  
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/favicon-192x192.png">
  <link rel="apple-touch-icon" href="/assets/images/favicon-192x192.png">

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={mainDesc}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={`${siteUrl}/assets/images/aatu-alatalo-valokuvaaja-oulu.jpg`}>
  <meta property="og:url" content={canonicalUrl}>

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={pageTitle}>
  <meta name="twitter:description" content={mainDesc}>
  <meta name="twitter:image" content={`${siteUrl}/assets/images/aatu-alatalo-valokuvaaja-oulu.jpg`}>

  {translationUrl && <link rel="alternate" hreflang="fi" href={siteUrl + canonicalPath(fiTransUrl)} />}
  {translationUrl && <link rel="alternate" hreflang="en" href={siteUrl + canonicalPath(enTransUrl)} />}
  {translationUrl && <link rel="alternate" hreflang="x-default" href={siteUrl + canonicalPath(enTransUrl)} />}

  <!-- Schema.org Structured Data for Google Knowledge Graph & SEO -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Person",
        "@id": "https://aatualatalo.com/#person",
        "name": "Aatu Elias Alatalo",
        "alternateName": ["Aatu Alatalo", "Teeaatu"],
        "jobTitle": "Valokuvaaja",
        "description": "Suomalainen valokuvaaja ja Hasselblad Masters 2026 -finalisti (Project//21).",
        "url": "https://aatualatalo.com",
        "image": "https://aatualatalo.com/assets/images/aatu-alatalo-valokuvaaja-oulu.jpg",
        "birthDate": "2005-01-25",
        "birthPlace": {
          "@type": "Place",
          "name": "Tyrnävä, Finland"
        },
        "homeLocation": {
          "@type": "Place",
          "name": "Oulu, Finland"
        },
        "nationality": {
          "@type": "Country",
          "name": "Finland"
        },
        "alumniOf": [
          {
            "@type": "EducationalOrganization",
            "name": "Jokilaaksojen koulutuskuntayhtymä Jedu"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Oulun ammattikorkeakoulu"
          }
        ],
        "award": [
          "Hasselblad Masters 2026 Finalist (Project//21)",
          "SAKUstars 2023 Honorable Mention (Photographic Art in a Day)"
        ],
        "sameAs": [
          "https://www.instagram.com/teeaatu/",
          "https://www.linkedin.com/in/aatu-alatalo-b67274304/",
          "https://www.hasselblad.com/inspiration/masters/2026/"
        ],
        "knowsAbout": [
          "Photography",
          "Fine Art Photography",
          "Portrait Photography",
          "Street Photography",
          "Landscape Photography",
          "Documentary Photography"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://aatualatalo.com/#website",
        "url": "https://aatualatalo.com",
        "name": "Aatu Alatalo Portfolio",
        "description": mainDesc,
        "publisher": {
          "@id": "https://aatualatalo.com/#person"
        },
        "inLanguage": ["fi", "en"]
      }
    ]
  })} />
  <!-- Fonts preload & CSS -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://media.aatualatalo.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400..600;1,400..600&display=swap" rel="stylesheet">
  {hasMap && <>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script defer src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  </>}
  <style is:global>
    /* ─── RESET ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      color-scheme: light;
      --jd-bg:       #ffffff;
      --jd-text:     #1a1a18;
      --jd-dimmed:   #888880;
      --jd-font:     'EB Garamond', Garamond, 'Adobe Garamond Pro', Georgia, serif;
      --jd-font-serif: var(--jd-font);
      --jd-font-garamond: var(--jd-font);
      --jd-panel-w:  min(500px, 42vw);
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--jd-bg);
      color: var(--jd-text);
      font-family: var(--jd-font);
    }

    /* The gallery stays light even when the browser canvas uses a dark theme. */
    body { color-scheme: light; }

    a { color: inherit; text-decoration: none; }
    img { -webkit-user-drag: none; user-select: none; -webkit-user-select: none; -webkit-touch-callout: none; pointer-events: none; }

    /* Tactile press feedback */
    .jd-bottom-btn, .jd-index-link {
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease !important;
      will-change: transform, opacity;
    }
    .jd-bottom-btn { display: inline-block; transform-origin: center; }
    .jd-index-link { transform-origin: left center; }
    .jd-bottom-btn:active, .jd-index-link:active {
      transform: scale(0.985) !important; opacity: 0.6 !important;
      transition: transform 0.05s ease, opacity 0.05s ease !important;
    }

    /* ─── MAIN ───────────────────────────────────────── */
    #jd-main {
      position: absolute !important;
      inset: 0 !important;
      background: var(--jd-bg);
    }

    /* ─── SLIDESHOW ─────────────────────────────────── */
    #jd-slideshow {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      user-select: none; -webkit-user-select: none;
    }
    .jd-slide {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0;
      transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
      pointer-events: none;
      will-change: opacity;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }
    .jd-slide.active { opacity: 1; pointer-events: auto; }
    @media (min-width: 801px) {
      .jd-slide { transition-duration: 0.22s; }
      /* Send gallery input to the stationary slideshow, even between frames. */
      #jd-slideshow .jd-slide { pointer-events: none; }
      #jd-slideshow:not(.wheel-browsing) .jd-slide.active :is(.jd-postcard-map, .jd-masters-info-trigger) {
        pointer-events: auto;
      }
      #jd-slideshow.wheel-browsing .jd-slide {
        opacity: 0;
        visibility: hidden;
        transition: none !important;
      }
      #jd-slideshow.wheel-restoring .jd-slide { transition: none !important; }
      .jd-slide.wheel-motion {
        opacity: 1 !important;
        transition: none !important;
        pointer-events: none;
      }
    }
    .jd-slide picture { display: contents; }
    @keyframes jd-photo-focus-motion {
      from {
        filter: var(--jd-photo-focus-from-filter);
        transform: var(--jd-photo-focus-from-transform);
      }
      to {
        filter: var(--jd-photo-focus-to-filter);
        transform: var(--jd-photo-focus-to-transform);
      }
    }
    .jd-slide img {
      max-width: calc(100% - 120px);
      max-height: calc(100vh - 148px); max-height: calc(100dvh - 148px);
      width: auto; height: auto; object-fit: contain; display: block;
      box-shadow: 0 5px 18px rgba(0, 0, 0, 0.10);
    }
    .jd-diptych-slide {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 24px;
      width: 100%;
      height: 100%;
      box-sizing: border-box;
      padding: 0 clamp(40px, 6vw, 80px);
    }
    .jd-diptych-slide picture {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      flex: 0 1 calc(50% - 12px) !important;
      max-width: calc(50% - 12px) !important;
      max-height: calc(100vh - 148px) !important;
      max-height: calc(100dvh - 148px) !important;
      height: auto !important;
      min-width: 0 !important;
    }
    .jd-diptych-slide img {
      max-width: 100% !important;
      max-height: calc(100vh - 148px) !important;
      max-height: calc(100dvh - 148px) !important;
      width: auto !important;
      height: auto !important;
      object-fit: contain !important;
      display: block !important;
    }

    #jd-masters-info-button {
      position: absolute; top: 10px; right: 10px; z-index: 5;
      display: grid; place-items: center; width: 44px; height: 44px; padding: 0;
      border: 0; border-radius: 50%; background: transparent; color: #242421;
      font: inherit; font-size: 1.25rem; line-height: 1; cursor: pointer;
      pointer-events: auto; -webkit-tap-highlight-color: transparent;
      box-shadow: none;
    }
    #jd-masters-info-button::before {
      content: ""; position: absolute; inset: 2px;
      border: 1px solid rgba(26, 26, 24, .22); border-radius: 50%;
      background: rgba(250, 250, 248, .92); box-shadow: 0 2px 12px rgba(0, 0, 0, .12);
      transition: background-color .18s ease;
    }
    #jd-masters-info-button:hover::before { background: #fff; }
    #jd-masters-info-button:focus-visible { outline: 2px solid currentColor; outline-offset: 1px; }
    #jd-masters-info-button span { position: relative; z-index: 1; }
    #jd-masters-info-button[hidden] { display: none; }
    .jd-masters-image-frame {
      position: relative; display: flex; align-items: center; justify-content: center;
      width: fit-content; height: fit-content; max-width: calc(100vw - 120px);
      max-height: calc(100dvh - 148px);
    }
    .jd-masters-image-frame img { max-width: calc(100vw - 120px); max-height: calc(100dvh - 148px); }
    @keyframes jdMastersInfoReveal { from { opacity: 0; transform: translateY(2px); } to { opacity: 1; transform: translateY(0); } }
    .jd-masters-info-trigger:not([hidden]) { animation: jdMastersInfoReveal .2s ease-out both; }
    @media (prefers-reduced-motion: reduce) { .jd-masters-info-trigger:not([hidden]) { animation: none; } }
    body.index-is-open #jd-masters-info-button, body.thumbs-is-open #jd-masters-info-button,
    body.about-is-open #jd-masters-info-button, html.jd-splash-active #jd-masters-info-button { visibility: hidden; }
    body:has(#jd-masters-info[open]) #jd-cursor-custom { display: none; }
    #jd-masters-info {
      margin: auto;
      width: min(520px, calc(100vw - 40px)); max-height: calc(100dvh - 48px);
      box-sizing: border-box; padding: 38px; border: 1px solid #e5e5e1;
      background: #fafaf8; color: #242421; overflow: auto; overscroll-behavior: contain;
      font-family: var(--jd-font); line-height: 1.6; text-align: left; cursor: auto;
    }
    #jd-masters-info:modal { overscroll-behavior: contain; }
    #jd-masters-info::backdrop { background: rgb(0 0 0 / .35); overflow: hidden; overscroll-behavior: contain; }
    #jd-masters-info h2 { font-family: var(--jd-font-serif); font-size: 1.8rem; font-weight: normal; line-height: 1.2; margin: 12px 0 20px; }
    #jd-masters-info h3 { font-size: 1rem; margin: 24px 0 8px; }
    #jd-masters-info p { font-size: .95rem; }
    #jd-masters-info .jd-masters-eyebrow { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; color: #666; }
    #jd-masters-info a { color: inherit; font-size: .85rem; text-underline-offset: 4px; }
    .jd-external-link-arrow { width: .8em; height: .8em; margin-inline-start: .28em; vertical-align: -.08em; }
    #jd-masters-info-close { position: absolute; right: 8px; top: 8px; width: 44px; height: 44px; border: 0; background: transparent; color: inherit; font-size: 26px; cursor: pointer; }
    @media (max-width: 800px) {
      .jd-masters-image-frame { max-width: calc(100vw - 20px); max-height: calc(100svh - 154px); }
      .jd-masters-image-frame img { max-width: calc(100vw - 20px) !important; max-height: calc(100svh - 154px) !important; }
      #jd-masters-info-button { top: 8px; right: 8px; }
      #jd-masters-info { padding: 30px 24px; }
    }

    /* Photo location label below image (Desktop) */
    .jd-slide-location {
      position: fixed;
      bottom: 28px;
      top: auto;
      left: 50%;
      transform: translateX(-50%);
      font-family: var(--jd-font);
      font-size: 0.95rem;
      letter-spacing: 0.04em;
      color: rgba(26, 26, 24, 0.76);
      pointer-events: none;
      user-select: none;
      white-space: nowrap;
      text-align: center;
      z-index: 10;
      opacity: 0;
      transition: opacity 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .jd-current-location {
      opacity: 1;
    }
    body.index-is-open .jd-slide-location,
    body.about-is-open .jd-slide-location,
    body.thumbs-is-open .jd-slide-location {
      opacity: 0 !important;
    }

    /* ─── TEXT SLIDES ───────────────────────────────── */
    .jd-text-slide { flex-direction: column; width: 100%; height: 100%; }
    .jd-text-content {
      background: transparent;
      padding: 2.5rem 1.5rem;
      max-width: 680px;
      width: 100%;
      text-align: center;
      display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1.5rem;
      position: relative;
    }
    .jd-text-content::before {
      display: none !important;
    }
    .jd-text-content h2 {
      font-family: var(--jd-font-garamond);
      font-size: clamp(2.2rem, 5vw, 3.4rem);
      font-weight: 300;
      line-height: 1.15;
      color: #111111;
      letter-spacing: -0.01em;
      margin: 0;
      opacity: 0;
      transform: translateY(24px);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s, transform 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
