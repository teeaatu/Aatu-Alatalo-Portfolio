      visibility: visible !important;
      pointer-events: auto !important;
      transform: scale(1) !important;
    }
    @media (max-width: 800px) {
      #jd-index-close-btn,
      #jd-about-close-btn {
        top: calc(16px + env(safe-area-inset-top, 0px)) !important;
        right: 20px !important;
        bottom: auto !important;
      }
