        padding-right: 1rem;
        box-sizing: border-box;
        align-items: center;
        justify-content: space-between;
        background: rgba(255, 255, 255, 0.94);
        backdrop-filter: blur(16px) saturate(180%);
        -webkit-backdrop-filter: blur(16px) saturate(180%);
        border-bottom: 1px solid rgba(26, 26, 24, 0.07);
        z-index: 350;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.25s ease, visibility 0.25s ease;
      }
      body.thumbs-is-open .jd-thumbs-header {
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
      }
      .jd-thumbs-header-inner {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .jd-thumbs-header-title {
        font-family: var(--jd-font);
        font-size: 1.02rem;
        letter-spacing: 0.03em;
        color: #1a1a18;
        font-weight: 500;
      }
      body.thumbs-is-open .jd-filter-dropdown-container {
        display: none !important;
        opacity: 0 !important;
        pointer-events: none !important;
      }
      #jd-thumbs-panel {
        padding-top: calc(52px + env(safe-area-inset-top, 0px) + 2rem) !important;
        padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px)) !important;
      }
    }

    .jd-mobile-edge { display: none; }
    @media (max-width: 800px) { .jd-mobile-edge { display: block; } }

    /* Safari 26 samples the frontmost fixed edge's computed background,
       not just theme-color. Keep these empty: text clipping leaves no visible
       stripe while preserving an opaque colour for WebKit's edge sampler.
       Both dimensions must exceed its 10px computed-colour shortcut cutoff.
       Reference: WebKit LocalFrameView::fixedContainerEdges / primaryBackgroundColorForRenderer. */
    .jd-safari-tint { display: none; }
    @supports (-webkit-touch-callout: none) {
      @media (max-width: 800px) {
        .jd-safari-tint {
          display: block;
          position: fixed;
          left: 0; right: 0;
          height: 11px;
          z-index: 2147483647;
          pointer-events: none;
          background-color: #000000;
          -webkit-background-clip: text;
          background-clip: text;
          border: 0;
          box-shadow: none;
          transition: none;
        }
        .jd-safari-tint-top { top: 0; }
        .jd-safari-tint-bottom { bottom: 0; }
        html[data-jd-tint-refresh] .jd-safari-tint { height: 12px; }
      }
    }

    /* ─── CINEMATIC EDITORIAL SPLASH SCREEN ────────────── */
    .jd-no-splash #jd-splash {
      display: none !important;
    }
    /* Estetään kategoriaotsikon (Uusimmat) ja vanhan verhon näkyminen splashin päällä */
    html:not(.jd-no-splash) .jd-shutter-title,
    html:not(.jd-no-splash) #jd-shutter-container {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
      pointer-events: none !important;
    }
    .jd-splash-screen {
      position: fixed;
      /* Keep the initial opaque surface on the actual viewport edges so
         Safari can sample it without an offscreen transformed cover. */
      inset: 0;
      width: 100%;
      height: 100%;
      background: #000000;
      z-index: 2147483647 !important;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      pointer-events: auto;
      cursor: pointer;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
      transform: none;
      transition: transform 0.9s cubic-bezier(0.65, 0, 0.25, 1);
      touch-action: none;
    }
    .jd-splash-screen.jd-splash-dismissed {
      overflow: visible;
      transform: translate3d(0, calc(-100% - var(--jd-curtain-edge)), 0) !important;
      pointer-events: none !important;
    }
    .jd-splash-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 0 1.5rem;
      box-sizing: border-box;
      will-change: transform, opacity;
      transform: translate3d(0, 0, 0);
      transition: transform 0.78s cubic-bezier(0.65, 0, 0.25, 1), opacity 0.45s ease;
    }
    /* Teksti ampaisee ensin ylös */
    .jd-splash-screen.jd-splash-text-exit .jd-splash-inner {
      transform: translate3d(0, -115vh, 0) !important;
      opacity: 0.15 !important;
    }
    /* A single paint source during the intro. Opacity-zero fixed panels and
       backdrop filters can still affect Safari's obscured-edge colour sampling.
       Visibility preserves gallery geometry for direct image links. */
    html.jd-splash-active:not(.jd-splash-revealing) { --jd-bg: #000000; }
    html.jd-splash-active:not(.jd-splash-revealing) body > :not(#jd-splash):not(.jd-safari-tint) {
      visibility: hidden !important;
    }
    html.jd-splash-active:not(.jd-splash-revealing) body > :not(#jd-splash):not(.jd-safari-tint) * {
      visibility: hidden !important;
    }
    html.jd-splash-active #jd-index-panel,
    html.jd-splash-active #jd-index-overlay,
    html.jd-splash-active #jd-thumbs-panel,
    html.jd-splash-active .jd-floating-close-btn,
    html.jd-splash-active .jd-thumbs-header {
      display: none !important;
    }
    html.jd-splash-active body *,
    html.jd-splash-active body *::before,
    html.jd-splash-active body *::after {
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
    }
    .jd-splash-title-wrap {
      overflow: hidden;
      padding: 0.15em 0;
      display: flex;
      justify-content: center;
    }
    .jd-splash-title {
      margin: 0;
      padding: 0;
      font-family: var(--jd-font);
      font-size: clamp(2.1rem, 5.8vw, 4.8rem);
      font-weight: 400;
      letter-spacing: 0.08em;
      line-height: 1.1;
      color: #f7f7f5;
      text-transform: uppercase;
      white-space: nowrap;
      will-change: transform, opacity, filter;
      opacity: 0;
      filter: blur(12px);
      transform: translate3d(0, 20px, 0);
      animation: jdSplashFocusIn 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) 0.25s forwards;
    }
    .jd-splash-subtitle-wrap {
      overflow: hidden;
      margin-top: 1.2rem;
      padding: 0.15em 0;
    }
    .jd-splash-subtitle {
      display: inline-block;
      font-family: var(--jd-font);
      font-size: clamp(0.7rem, 1.3vw, 0.95rem);
      font-weight: 400;
      letter-spacing: 0.42em;
      color: rgba(247, 247, 245, 0.52);
      text-transform: uppercase;
      will-change: transform, opacity, filter;
      opacity: 0;
      filter: blur(8px);
      transform: translate3d(0, 14px, 0);
      animation: jdSplashFocusIn 1.0s cubic-bezier(0.2, 0.8, 0.2, 1) 0.5s forwards;
    }

    @keyframes jdSplashFocusIn {
      0% {
        opacity: 0;
        filter: blur(12px);
        transform: translate3d(0, 20px, 0);
      }
      100% {
        opacity: 1;
        filter: blur(0px);
        transform: translate3d(0, 0, 0);
      }
    }
  </style>
</head>
<body ontouchstart="">

