          </ul>
        </div>
        <div class="jd-about-section jd-about-contact">
          <h2>{lang === 'en' ? 'Contact & Inquiries' : 'Yhteydenotto & Tiedustelut'}</h2>
          <p style="font-size: 1.05rem; margin-bottom: 0.4rem;">
            <a href="mailto:info@aatualatalo.com" style="text-decoration: underline; text-underline-offset: 4px; font-weight: 500;">
              info@aatualatalo.com
            </a>
          </p>
          <p style="font-size: 0.92rem; opacity: 0.75; margin: 0; line-height: 1.5;">
            {lang === 'en' ? 'Oulu & Northern Ostrobothnia — Available for assignments, workshops, and collaborations across Finland by arrangement.' : 'Oulu & Pohjois-Pohjanmaa — Saatavilla toimeksiantoihin, opetukseen ja yhteistöihin myös valtakunnallisesti sopimuksen mukaan.'}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating close button for About -->
  <button type="button" id="jd-about-close-btn" class="jd-floating-close-btn" onclick="window.closeAboutPanel();" aria-label={lang === 'fi' ? 'Sulje' : 'Close'}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <!-- Shutter curtain -->
  <div id="jd-shutter-container" transition:persist="gallery-curtain">
    <div class="jd-curtain-primary" aria-hidden="true"></div>
    <div class="jd-shutter-title">{catLabel}</div>
  </div>

  <!-- Mobile thumbs top bar -->
  <div id="jd-thumbs-header" class="jd-thumbs-header" aria-hidden="true">
    <div class="jd-thumbs-header-inner">
      <span class="jd-thumbs-header-title">{lang === 'en' ? 'Thumbs' : 'Kuvasto'}</span>
    </div>
  </div>

  <!-- Global thumbs panel (all categories) -->
  <div id="jd-thumbs-panel">
    <div class="jd-thumbs-inner">
      {CATEGORIES.map(cat => {
        const { key, data } = cat;
        const catUrl = getCategoryUrl(key, activeLang);
        const sectionLabel = cat.label(activeLang);
        return data && data.length > 0 ? (
          <div class="jd-thumbs-section" id={`jd-thumbs-section-${key}`}>
            <div class="jd-thumbs-section-title">{sectionLabel}</div>
            <div class="jd-thumbs-grid">
              {data.filter((item: any) => key === 'work1' || item.tyyppi !== 'teksti').map((item: any, idx: number) => {
                const itemKey = item.kuva || (item.layout === 'diptych' && item.images ? item.images.map((i: any) => i.kuva).join('|') : (item.otsikko ? `text_${item.otsikko}` : `item_${idx}`));
                if (item.tyyppi === 'teksti') {
                  const tStr = parseLocalizedField(item.otsikko || '', activeLang);
                  return (
                    <div class="jd-thumb-global jd-thumb-text" data-cat={key} data-cat-label={sectionLabel} data-key={itemKey} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                      <div class="jd-thumb-text-inner">
                        <h3>{tStr}</h3>
                      </div>
                    </div>
                  );
                }
                const mediaItem = item.layout === 'diptych' && item.images ? item.images[0] : item;
                if (!mediaItem?.kuva) return null;
                const paths = resolveImagePaths(mediaItem.kuva);
                return (
                  <div class="jd-thumb-global" data-cat={key} data-cat-label={sectionLabel} data-key={itemKey} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                    <img
                      src={paths.srcMob}
                      srcset={`${paths.srcMob} 600w, ${paths.src} 1600w`}
                      sizes="(max-width: 800px) 50vw, 25vw"
                      width={mediaItem.width || undefined}
                      height={mediaItem.height || undefined}
                      loading="lazy"
                      decoding="async"
                      alt={mediaItem.alt_text || ''}
                    >
                  </div>
                );
              })}
            </div>
          </div>
        ) : null;
      })}
    </div>
  </div>

  <!-- Floating close button for Kuvasto (Thumbs) -->
  <button type="button" id="jd-thumbs-close-btn" class="jd-floating-close-btn" onclick="if(typeof closeThumbsView==='function')closeThumbsView();" aria-label={lang === 'fi' ? 'Sulje kuvasto' : 'Close overview'}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <script is:inline data-astro-rerun>
  (() => {
  function initializeGallery() {
    const galleryEvents = new AbortController();
    const { signal } = galleryEvents;
    const listen = (target, type, handler, options) => target.addEventListener(type, handler, { ...options, signal });
    const observers = [];
    const getSession = (key) => { try { return sessionStorage.getItem(key); } catch { return null; } };
    const setSession = (key, value) => { try { sessionStorage.setItem(key, String(value)); } catch {} };
    let tintFrame = 0;
    let splashAutoTimer = 0;
    let splashRemovalTimer = 0;
    let previewSwitchTimeout = null;
    let previewHideTimeout = null;
    let lastMouseX = null;
    let lastMouseY = null;
    const persistCursorPos = () => {
      if (lastMouseX !== null && lastMouseY !== null) {
        setSession('jdLastMouseX', lastMouseX);
        setSession('jdLastMouseY', lastMouseY);
      }
    };
    listen(window, 'pagehide', persistCursorPos);
    listen(document, 'astro:before-swap', () => {
      persistCursorPos();
      galleryEvents.abort();
      observers.forEach(observer => observer.disconnect());
      cancelWheelMotion();
      cancelAnimationFrame(tintFrame);
      cancelAnimationFrame(wheelRestoreFrame);
      cancelAnimationFrame(mobileGeometryFrame);
      cancelAnimationFrame(mobileScrollFrame);
      clearTimeout(mobileSettleTimer);
      cancelAnimationFrame(mobileSettleFrame);
      clearTimeout(splashAutoTimer);
      clearTimeout(splashRemovalTimer);
      clearTimeout(previewSwitchTimeout);
      clearTimeout(previewHideTimeout);
    }, { once: true });
    // Invalidate Safari's cached edge colour after navigation, viewport changes,
    // and overlays. A two-frame geometry pulse paints no pixels and never scrolls.
    if (CSS.supports('-webkit-touch-callout', 'none')) {
      const refreshTint = () => {
        cancelAnimationFrame(tintFrame);
        if (!matchMedia('(max-width: 800px)').matches) {
          document.documentElement.removeAttribute('data-jd-tint-refresh');
          return;
        }
        document.documentElement.setAttribute('data-jd-tint-refresh', '');
        tintFrame = requestAnimationFrame(() => {
          tintFrame = requestAnimationFrame(() => {
            document.documentElement.removeAttribute('data-jd-tint-refresh');
            tintFrame = 0;
          });
        });
      };
      listen(window, 'pageshow', refreshTint);
      listen(window, 'resize', refreshTint);
      listen(window, 'jd:splash-dismissed', refreshTint);
      const tintObserver = new MutationObserver(refreshTint);
      tintObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
      observers.push(tintObserver);
      refreshTint();
    }
    // ─── SPLASH SCREEN CONTROLLER ───────────────────────────
    const splashEl = document.getElementById('jd-splash');
    const splashRoot = document.documentElement;
    function restoreGalleryTheme() {
      window.jdSyncBrowserTheme();
    }
    function finishSplash() {
      splashEl?.remove();
      splashRoot.classList.remove('jd-splash-active', 'jd-splash-revealing');
      splashRoot.classList.add('jd-no-splash');
      restoreGalleryTheme();
      window.dispatchEvent(new Event('jd:splash-dismissed'));
    }
    if (splashEl) {
      if (splashRoot.classList.contains('jd-no-splash')) {
        finishSplash();
      } else {
        setSession('jd_splash_seen', 'true');
        let splashDismissed = false;
        function dismissSplash() {
          if (splashDismissed) return;
          splashDismissed = true;
          clearTimeout(splashAutoTimer);
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) { finishSplash(); return; }
          splashEl.classList.add('jd-splash-text-exit');
          setTimeout(() => {
            if (signal.aborted) return;
            // Reveal a fully light gallery, including its edge masks. The black
            // curtain alone travels upward; no black bars remain beneath it.
            splashRoot.classList.add('jd-splash-revealing');
            restoreGalleryTheme();
            splashEl.classList.add('jd-splash-dismissed');
          }, 100);
          // Prefer completion of the actual curtain; timer covers interrupted transitions.
          splashEl.addEventListener('transitionend', event => {
            if (event.target !== splashEl || event.propertyName !== 'transform') return;
            clearTimeout(splashRemovalTimer);
            finishSplash();
          });
          splashRemovalTimer = setTimeout(finishSplash, 1150);
        }
        splashAutoTimer = setTimeout(dismissSplash, 2400);
        splashEl.addEventListener('click', dismissSplash);
        listen(window, 'keydown', dismissSplash, { once: true });
      }
    }

    const metaEl = document.getElementById('jd-meta');
    const meta = metaEl ? JSON.parse(metaEl.textContent || '{}') : {};
    const { catLabel, categorySlug, isEventsCategory } = meta;

    const dataEl = document.getElementById('jd-data');
    const data = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
    const total = data.length;

    const mastersInfo = document.getElementById('jd-masters-info');
    const mastersInfoButton = document.getElementById('jd-masters-info-button');
    if (mastersInfo) {
      if (!('commandForElement' in HTMLButtonElement.prototype)) {
        document.querySelectorAll('.jd-masters-info-trigger').forEach(button => {
          button.addEventListener('click', () => mastersInfo.showModal());
        });
        document.getElementById('jd-masters-info-close')?.addEventListener('click', () => mastersInfo.close());
      }
      if (!('closedBy' in HTMLDialogElement.prototype)) {
        const outsideDialog = event => {
          const bounds = mastersInfo.getBoundingClientRect();
          return event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom;
        };
        let pressedOutside = false;
        mastersInfo.addEventListener('pointerdown', event => { pressedOutside = outsideDialog(event); });
        mastersInfo.addEventListener('pointerup', event => {
          if (pressedOutside && outsideDialog(event)) mastersInfo.close();
        });
      }
      mastersInfo.addEventListener('click', event => event.stopPropagation());
      mastersInfo.addEventListener('keydown', event => event.stopPropagation());
      mastersInfo.addEventListener('wheel', event => event.stopPropagation());
    }

    const slideshow = document.getElementById('jd-slideshow');
    const thumbsPanel = document.getElementById('jd-thumbs-panel');
    const counterNum = document.getElementById('jd-counter-num');
    const cursor = document.getElementById('jd-cursor-custom');
    const shutter = document.querySelector('.jd-curtain-primary');
    const shutterTitle = document.querySelector('.jd-shutter-title');
    const initialShutterTitle = shutterTitle?.textContent;
    if (shutterTitle && typeof window.jdCategoryArrivalTitle === 'string') {
      shutterTitle.textContent = window.jdCategoryArrivalTitle;
      document.body.classList.toggle('hide-shutter-title', !window.jdCategoryArrivalTitle);
    }
    const curtainRevealMs = 760;

    if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);

    const slides = [];
    let current = 0;
    let thumbsOpen = false;

    const hash = window.location.hash;
    if (hash && hash.startsWith('#img-')) {
      const idx = parseInt(hash.replace('#img-', ''), 10);
      if (!isNaN(idx) && idx >= 0 && idx < total) current = idx;
    }

    function createSlide(item, i) {
      const slide = document.createElement('div');
      slide.className = 'jd-slide' + (i === current ? ' active' : '');
      if (item.type === 'text') {
        slide.className += ' jd-text-slide';
        const content = document.createElement('div');
        if (item.kartta) {
          content.className = 'jd-text-content jd-postcard-content';
          if (item.title) {
            const h2 = document.createElement('h2');
            h2.textContent = item.title;
            content.appendChild(h2);
          }
          if (item.text) {
            const p = document.createElement('p');
            p.textContent = item.text;
            content.appendChild(p);
          }
          if (window.L) {
            const mapContainer = document.createElement('div');
            mapContainer.className = 'jd-postcard-map';
            content.appendChild(mapContainer);
            
            setTimeout(() => {
              const map = L.map(mapContainer, {
                center: item.kartta.center || [60, 25],
                zoom: item.kartta.zoom || 8,
                zoomControl: false,
                dragging: false,
                touchZoom: false,
                doubleClickZoom: false,
                scrollWheelZoom: false,
                boxZoom: false,
                keyboard: false
              });
              L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO'
              }).addTo(map);
              
              if (item.kartta.points && item.kartta.points.length > 0) {
                const dotIcon = L.divIcon({ className: 'jd-map-dot-wrapper', html: '<div class="jd-map-dot"></div>', iconSize: [14, 14] });
                const bounds = L.latLngBounds();
                item.kartta.points.forEach(pt => {
                  const coords = pt.latlng || pt;
                  bounds.extend(coords);
                  const marker = L.marker(coords, { icon: dotIcon }).addTo(map);
                  if (pt.nimi) {
                    marker.bindTooltip(pt.nimi, {
                      permanent: true,
                      direction: 'top',
                      className: 'jd-map-tooltip',
                      offset: [0, -5],
                      opacity: 1
                    });
                  }
                });
                map.fitBounds(bounds, { padding: [40, 40], maxZoom: 10 });
              }
            }, 300);
          }
        } else {
          content.className = 'jd-editorial-content';
          if (item.title) {
            const h2 = document.createElement('h2');
            h2.textContent = item.title;
            content.appendChild(h2);
          }
          if (item.text) {
            const p = document.createElement('p');
            p.textContent = item.text;
            content.appendChild(p);
          }
        }
        slide.appendChild(content);
      } else if (item.layout === 'diptych' && item.images) {
        slide.className += ' jd-diptych-slide';
        item.images.forEach(imgData => {
          slide.appendChild(buildSlidePicture(imgData, i, '(max-width: 768px) 100vw, 50vw'));
        });
      } else {
        const picture = buildSlidePicture(item, i, '(max-width: 600px) 800px, (max-width: 1400px) 1600px, 3000px');
        if (categorySlug === 'masters-2026' && i === 0) {
          const frame = document.createElement('div');
          frame.className = 'jd-masters-image-frame';
          frame.appendChild(picture);
          if (mastersInfoButton) frame.appendChild(mastersInfoButton);
          slide.appendChild(frame);
        } else {
          slide.appendChild(picture);
        }
      }
      return slide;
    }

    function getImageMimeType(url) {
      if (!url) return 'image/jpeg';
      const clean = url.split(/[?#]/)[0].toLowerCase();
      if (clean.endsWith('.webp')) return 'image/webp';
      if (clean.endsWith('.avif')) return 'image/avif';
      if (clean.endsWith('.png')) return 'image/png';
      return 'image/jpeg';
    }

    function buildSlidePicture(imgData, slideIndex, sizes) {
      const picture = document.createElement('picture');

      // 1. Retina-näytöille & suurille näytöille alkuperäinen master-tiedosto.
      const retinaSrc = document.createElement('source');
      retinaSrc.type = getImageMimeType(imgData.full);
      retinaSrc.media = '(min-width: 1600px), (-webkit-min-device-pixel-ratio: 1.5) and (min-width: 801px)';
      retinaSrc.srcset = imgData.full;
      picture.appendChild(retinaSrc);

      // 2. Tavallisille desktop-näytöille (ei-retina, 801-1599px) 1600px AVIF.
      if (imgData.srcAvif) {
        const avifSrc = document.createElement('source');
        avifSrc.type = 'image/avif';
        avifSrc.media = '(min-width: 801px)';
        avifSrc.srcset = imgData.srcAvif;
        picture.appendChild(avifSrc);
      }

      // 3. Fallback & mobiililaitteet: selaimen valitsema WebP-koko.
      const webpSrc = document.createElement('source');
      webpSrc.type = 'image/webp';
      webpSrc.srcset = imgData.srcset;
      webpSrc.sizes = sizes;
      picture.appendChild(webpSrc);

      const img = document.createElement('img');
      img.src = imgData.src;
      img.alt = imgData.alt || '';
      if (imgData.width) img.width = imgData.width;
      if (imgData.height) img.height = imgData.height;
      const isLcp = slideIndex === current;
      const isAdjacent = slideIndex === current + 1;
      img.loading = (isLcp || isAdjacent) ? 'eager' : 'lazy';
      img.decoding = isLcp ? 'sync' : 'async';
      if (isLcp) img.fetchPriority = 'high';
      else if (!isAdjacent) img.fetchPriority = 'low';
      img.onerror = () => {
        img.onerror = null;
        picture.querySelectorAll('source').forEach(s => s.remove());
        img.src = imgData.full;
      };
      picture.appendChild(img);
      return picture;
    }

    const desktopLocation = document.createElement('div');
    desktopLocation.className = 'jd-slide-location jd-current-location';
    document.body.appendChild(desktopLocation);

    data.forEach((item, i) => {
      const slide = createSlide(item, i);
      slideshow.appendChild(slide);
      slides.push(slide);
    });

    // Cache gallery references; scrolling only updates changed text and nearby slides.
    const localThumbs = Array.from(document.querySelectorAll(`.jd-thumb-global[data-cat="${categorySlug}"]`));
    const slideImages = slides.map(slide => Array.from(slide.querySelectorAll('img')));
    const counterUI = Object.fromEntries(['jd-wheel-counter', 'jd-counter-cat', 'jd-counter-num',
      'jd-counter-tot', 'jd-counter-rest', 'jd-counter-place', 'jd-cursor-text']
      .map(id => [id, document.getElementById(id)]));
    let displayedIndex = current;
    let counterSignature = '';
    const preparedImages = new WeakMap();
    const photoFocusAnimations = new WeakMap();
    const desktopPhotoMotion = { blur: 1.04625, brightness: 0.979075, offset: 6.045, rotation: 1.04625, scale: 0.9941875, duration: 360 };

    function animatePhotoFocus(slide, direction, entering, motion) {
      if (!slide || slide.classList.contains('jd-text-slide') || reducedMotion.matches) return;
      const sign = Math.sign(direction) || 1;
      const edgeOffset = entering ? sign * motion.offset : -sign * motion.offset;
      const edgeRotation = entering ? -sign * motion.rotation : sign * motion.rotation;
      const edgeFrame = {
        filter: `blur(${motion.blur}px) brightness(${motion.brightness})`,
        transform: motion.offset || motion.rotation || motion.scale !== 1
          ? `perspective(1100px) translate3d(${edgeOffset}px, 0, 0) rotateY(${edgeRotation}deg) scale(${motion.scale})`
          : 'none',
      };
      const settledFrame = {
        filter: 'blur(0px) brightness(1)',
        transform: 'none',
      };
      slide.querySelectorAll('img').forEach(img => {
        if (!img.complete || !img.naturalWidth) return;
        photoFocusAnimations.get(img)?.cancel();
        const frames = entering ? [edgeFrame, settledFrame] : [settledFrame, edgeFrame];
        if (typeof img.animate === 'function') {
          const animation = img.animate(frames, {
            duration: motion.duration,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'none',
          });
          const handle = { cancel: () => animation.cancel() };
          photoFocusAnimations.set(img, handle);
          animation.onfinish = () => {
            if (photoFocusAnimations.get(img) === handle) photoFocusAnimations.delete(img);
          };
          return;
        }

        // Some Safari and embedded browser builds expose CSS animations but
        // not Element.animate(). Use the same keyframes through CSS there.
        const styleProperties = [
          '--jd-photo-focus-from-filter', '--jd-photo-focus-from-transform',
          '--jd-photo-focus-to-filter', '--jd-photo-focus-to-transform',
          'animation-name', 'animation-duration', 'animation-timing-function', 'animation-fill-mode',
        ];
        const previousStyles = styleProperties.map(property => ({
          property,
          value: img.style.getPropertyValue(property),
          priority: img.style.getPropertyPriority(property),
        }));
        let active = true;
        const cleanup = () => {
          if (!active) return;
          active = false;
          img.removeEventListener('animationend', onAnimationEnd);
          previousStyles.forEach(({ property, value, priority }) => {
            if (value) img.style.setProperty(property, value, priority);
            else img.style.removeProperty(property);
          });
          if (photoFocusAnimations.get(img) === handle) photoFocusAnimations.delete(img);
        };
        const handle = { cancel: cleanup };
        const onAnimationEnd = event => {
          if (event.target === img && event.animationName === 'jd-photo-focus-motion') cleanup();
        };
        photoFocusAnimations.set(img, handle);
        img.style.animationName = 'none';
        void img.offsetWidth;
        img.style.setProperty('--jd-photo-focus-from-filter', frames[0].filter);
        img.style.setProperty('--jd-photo-focus-from-transform', frames[0].transform);
        img.style.setProperty('--jd-photo-focus-to-filter', frames[1].filter);
        img.style.setProperty('--jd-photo-focus-to-transform', frames[1].transform);
        img.style.animationName = 'jd-photo-focus-motion';
        img.style.animationDuration = `${motion.duration}ms`;
        img.style.animationTimingFunction = 'cubic-bezier(0.22, 1, 0.36, 1)';
        img.style.animationFillMode = 'none';
        img.addEventListener('animationend', onAnimationEnd);
      });
    }

    function prepareNearbyImages(index) {
      const vi = visibleIndices.indexOf(index);
      if (vi < 0) return;
      // No wraparound: prepare only actual neighbours, including both diptych images.
      [vi, vi + 1, vi + 2, vi - 1].forEach(position => {
        const target = visibleIndices[position];
        if (target === undefined) return;
        slideImages[target].forEach(img => {
          img.loading = 'eager';
          const source = img.currentSrc || img.src;
          if (!source || preparedImages.get(img) === source) return;
          preparedImages.set(img, source);
          if (typeof img.decode === 'function') img.decode().catch(() => {
            // A source change or failed download must never block navigation.
            preparedImages.delete(img);
          });
        });
      });
    }

    /* Filter */
    const filterContainer = document.getElementById('jd-filter-dropdown-container');
    const filterToggle = document.getElementById('jd-filter-toggle');
    const filterMenu = document.getElementById('jd-filter-menu');
    let uniqueSeries = [...new Set(data.map(item => item.series))].filter(s => s && s !== 'all');
    let currentFilter = 'all';
    let visibleIndices = data.map((_, i) => i);
    let visibleTotal = visibleIndices.length;

    if (uniqueSeries.length > 1 && filterContainer && (isEventsCategory || categorySlug === 'recent')) {
      filterContainer.classList.add('is-visible');
      const btnAll = document.createElement('button');
      btnAll.className = 'jd-filter-btn active'; btnAll.textContent = meta.lang === 'fi' ? 'KAIKKI' : 'ALL';
      btnAll.dataset.filter = 'all'; filterMenu.appendChild(btnAll);
      uniqueSeries.forEach(s => {
        const btn = document.createElement('button');
        btn.className = 'jd-filter-btn'; btn.textContent = s.toUpperCase().replace(/-/g, ' ');
        btn.dataset.filter = s; filterMenu.appendChild(btn);
      });
      filterToggle.addEventListener('click', e => { e.stopPropagation(); filterMenu.classList.toggle('is-open'); filterToggle.classList.toggle('is-open'); });
      listen(document, 'click', e => { if (!filterContainer.contains(e.target)) { filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); } });
      filterMenu.addEventListener('click', e => { if (e.target.tagName === 'BUTTON') { const f = e.target.dataset.filter; filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); if (f !== currentFilter) applyFilter(f); } });
    }

    function applyFilter(filter) {
      currentFilter = filter;
      visibleIndices = [];
      data.forEach((item, i) => { if (filter === 'all' || item.series === filter) visibleIndices.push(i); });
      visibleTotal = visibleIndices.length;
      slides.forEach((slide, index) => slide.classList.toggle('is-filtered-out', !visibleIndices.includes(index)));
      document.querySelectorAll('.jd-filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
      const filterBase = window.innerWidth <= 800 ? mobileNavigationIndex() : current;
      let newCurrent = visibleIndices.includes(filterBase) ? filterBase : visibleIndices[0];
      if (newCurrent === undefined) newCurrent = 0;
      rebuildMobileCentres();
      goToAbsolute(newCurrent, true);
    }

    /* Thumbs listeners */
