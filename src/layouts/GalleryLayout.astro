      top: 8px; left: 8px; right: 8px; bottom: 8px;
      border: 1px solid rgba(0, 0, 0, 0.05);
      pointer-events: none;
    }
    .jd-thumb-global:hover .jd-thumb-text-inner { opacity: 0.7; }
    .jd-thumb-global.is-active .jd-thumb-text-inner { outline: 2px solid #1a1a18; outline-offset: 6px; }
    .jd-thumb-text-inner h3 { font-family: var(--jd-font-serif); font-size: 1.1rem; margin-bottom: 1rem; font-weight: normal; color: #1a1a18; line-height: 1.2; z-index: 2; }
    .jd-thumb-text-inner p { font-family: var(--jd-font); font-size: 0.85rem; color: #555; z-index: 2; }

    /* ─── NAV BUTTONS (Desktop: Top / Mobile: Top) ──── */
    #jd-bottom-nav {
      position: fixed; top: 15px; bottom: auto; left: 50%; right: auto; transform: translateX(-50%); height: auto; padding: 0;
      display: flex !important; flex-direction: row !important; align-items: center !important; justify-content: center !important;
      z-index: 100000; pointer-events: auto; cursor: auto;
      transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }
    #jd-normal-nav {
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      gap: 3.5rem !important;
      pointer-events: auto !important;
    }
    body.index-is-open #jd-bottom-nav,
    body.index-is-open #jd-counter,
    body.index-is-open #jd-hint-arrows,
    body.index-is-open .jd-filter-dropdown-container {
      opacity: 0 !important; visibility: hidden !important; pointer-events: none !important;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }
    @media (min-width: 801px) {
      body.index-is-open #jd-bottom-nav {
        left: calc((100vw - var(--jd-panel-w)) / 2) !important;
        opacity: 1 !important;
        visibility: visible !important;
        pointer-events: auto !important;
        transition: left 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease, visibility 0.3s ease;
      }
    }
    .jd-bottom-btn {
      background: none; border: none;
      color: rgba(26, 26, 24, 0.72) !important; -webkit-text-fill-color: rgba(26, 26, 24, 0.72) !important;
      font-family: var(--jd-font);
      font-size: 0.95rem; font-weight: 500; letter-spacing: 0.04em; text-transform: none !important;
      cursor: pointer !important; pointer-events: auto;
      padding: 8px 0;
      min-height: 44px; display: inline-flex; align-items: center; justify-content: center;
      transition: opacity 0.25s ease, transform 0.2s ease, color 0.2s ease;
      white-space: nowrap;
    }
    .jd-bottom-btn:hover {
      color: #1a1a18 !important; -webkit-text-fill-color: #1a1a18 !important;
      opacity: 1 !important;
    }
    #jd-counter { display: none; }

    #jd-wheel-counter { display: none; }
    @media (min-width: 801px) {
      #jd-wheel-counter {
        position: fixed;
        top: 24px;
        right: 60px;
        height: 44px;
        display: inline-flex;
        align-items: center;
        font-family: var(--jd-font);
        font-size: 0.95rem;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.04em;
        color: rgba(26, 26, 24, 0.72);
        white-space: nowrap;
        pointer-events: none;
        user-select: none;
        z-index: 100000;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-4px);
        transition: opacity 180ms ease, transform 180ms ease, visibility 180ms ease;
      }
      body.is-wheel-browsing:not(.index-is-open):not(.thumbs-is-open):not(.about-is-open):not(.is-leaving) #jd-wheel-counter {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      #jd-wheel-counter { transition: none; transform: none; }
    }

    /* ─── SHUTTER / CURTAIN ─────────────────────────── */
    #jd-shutter-container,
    .jd-splash-screen {
      --jd-curtain-edge: 56px;
    }
    #jd-shutter-container {
      position: fixed; inset: 0; z-index: 200000; pointer-events: none;
    }
    .jd-curtain-primary {
      position: absolute; inset: 0;
      background: #000; transform: translateY(0);
      pointer-events: none;
    }
    .jd-curtain-primary::before,
    .jd-curtain-primary::after,
    .jd-splash-screen.jd-splash-dismissed::after {
      content: '';
      position: absolute;
      inset-inline: 0;
      height: var(--jd-curtain-edge);
      background:
        radial-gradient(ellipse 35% 56px at 24% 100%, #000 57%, transparent),
        radial-gradient(ellipse 32% 40px at 80% 100%, #000 40%, transparent),
        linear-gradient(to top, #000, transparent 24px);
    }
    .jd-curtain-primary::before {
      bottom: 100%;
    }
    .jd-curtain-primary::after,
    .jd-splash-screen.jd-splash-dismissed::after {
      top: 100%;
      transform: rotate(180deg);
    }
    .jd-shutter-title {
      position: fixed; top: 50%; left: 50%; transform: translate(-50%, -50%);
      color: #fff; z-index: 99999999;
      font-family: var(--jd-font); font-size: 2rem; letter-spacing: 0.02em;
      opacity: 1; filter: blur(0); pointer-events: none; white-space: nowrap;
    }
    body.is-entering-ready .jd-curtain-primary {
      transition: transform 760ms cubic-bezier(0.42, 0, 0.42, 1) 100ms;
      transform: translateY(calc(100% + var(--jd-curtain-edge)));
    }
    body.is-entering-ready .jd-shutter-title {
      transform: translate(-50%, calc(-50% + 30px)) scale(1.08);
      opacity: 0;
      filter: blur(12px);
      transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1), opacity 300ms ease-in, filter 300ms ease-out;
    }
    body.prepare-leave .jd-curtain-primary {
      transition: none;
      transform: translateY(calc(-100% - var(--jd-curtain-edge)));
    }
    body.prepare-leave .jd-shutter-title {
      transform: translate(-50%, calc(-50% - 6px));
      opacity: 0;
      transition: none;
    }
    body.is-leaving .jd-curtain-primary {
      transition: transform 620ms cubic-bezier(0.42, 0, 0.48, 1);
      transform: translateY(0);
    }
    body.is-leaving .jd-shutter-title {
      transform: translate(-50%, -50%);
      opacity: 1;
      transition: transform 240ms cubic-bezier(0.22, 1, 0.36, 1) 330ms,
                  opacity 180ms ease-out 330ms;
    }
    body.hide-shutter-title .jd-shutter-title { opacity: 0 !important; }
    body.restore-category :is(.jd-curtain-primary, .jd-shutter-title) {
      transition: none !important;
    }

    @keyframes jd-category-text-reveal {
      from {
        opacity: 0;
        filter: blur(5px);
        -webkit-mask-position: 0 0%;
        mask-position: 0 0%;
      }
      to {
        opacity: 1;
        filter: blur(0);
        -webkit-mask-position: 0 100%;
        mask-position: 0 100%;
      }
    }
    @keyframes jd-category-image-focus {
      from { filter: blur(8px); }
      to { filter: blur(0); }
    }
    @media (prefers-reduced-motion: no-preference) {
      html.jd-category-revealing:not(.jd-category-departure) :is(#jd-normal-nav, #jd-counter, .jd-current-location) {
        -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%, #000);
        mask-image: linear-gradient(to bottom, transparent, #000 45%, #000);
        -webkit-mask-size: 100% 240%;
        mask-size: 100% 240%;
        animation: jd-category-text-reveal 700ms ease-out both;
      }
      html.jd-category-revealing:not(.jd-category-departure) .jd-slide.active img {
        animation: jd-category-image-focus 1100ms ease-out both;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      #jd-shutter-container, .jd-shutter-title { display: none; }
      .jd-slide, body.is-leaving #jd-cursor-custom {
        transition: none !important;
        animation: none !important;
      }
    }

    /* ─── INDEX PANEL ────────────────────────────────── */
    #jd-index-overlay {
      position: fixed; inset: 0;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      z-index: 499; opacity: 0; visibility: hidden; pointer-events: none;
      transition: opacity 0.4s ease, visibility 0.4s ease;
    }
    #jd-index-overlay.is-open {
      opacity: 1; visibility: visible; pointer-events: auto; cursor: pointer;
    }
    #jd-index-panel {
      position: fixed !important; top: 0 !important; right: 0; left: auto;
      width: var(--jd-panel-w); height: 100dvh !important;
      background: rgba(255, 255, 255, 0.97);
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      backdrop-filter: saturate(180%) blur(24px);
      color: var(--jd-text);
      z-index: 500; padding: 4rem 2.5rem 2.5rem;
      overflow-y: auto; overscroll-behavior-y: contain; cursor: auto;
      transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease;
      transform: translateX(100%); opacity: 0;
      border-left: 1px solid rgba(0, 0, 0, 0.06);
    }
    @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
      #jd-index-panel { background: var(--jd-bg); }
    }
    #jd-index-panel.is-open { transform: translateX(0); opacity: 1; }
    #jd-index-panel a, #jd-index-panel div, #jd-index-panel span { color: var(--jd-text) !important; }

    /* ─── INDEX HOVER PREVIEW (DESKTOP) ───────────────── */
    #jd-index-preview-container {
      position: fixed;
      top: 0;
      left: 0;
      width: calc(100vw - var(--jd-panel-w));
      height: 100dvh;
      pointer-events: none;
      z-index: 502;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 3rem 4rem;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s ease;
    }
    body.index-is-open #jd-index-preview-container {
      opacity: 1;
      visibility: visible;
    }
    #jd-index-preview-wrapper {
      position: relative;
      width: 100%;
      height: 100%;
      max-width: 88%;
      max-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .jd-preview-layer {
      position: absolute;
      max-width: 100%;
      max-height: 80vh;
      width: auto;
      height: auto;
      object-fit: contain;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.24);
      border-radius: 1px;
      opacity: 0;
      transform: scale(0.975);
      transition: opacity 0.9s cubic-bezier(0.16, 1, 0.3, 1), transform 1.1s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }
    .jd-preview-layer:not([src]) {
      display: none;
    }
    .jd-preview-layer.is-active {
      opacity: 1;
      transform: scale(1);
    }
    @media (max-width: 768px) {
      #jd-index-preview-container {
        display: none !important;
      }
    }

    /* Normal cursor when index is open */
    body.index-is-open,
    body.index-is-open * {
      cursor: auto !important;
    }
    body.index-is-open .jd-index-link,
    body.index-is-open .jd-top-nav a,
    body.index-is-open button,
    body.index-is-open #jd-index-overlay {
      cursor: pointer !important;
    }
    body.index-is-open #jd-cursor-custom {
      display: none !important;
      opacity: 0 !important;
      visibility: hidden !important;
    }

    /* Index panel inner styles */
