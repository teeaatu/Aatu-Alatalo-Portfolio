          </div>
        </header>
        <div class="jd-about-bio">
          {lang === 'en' ? (
            <>
              <p>I am a 21-year-old photographer from the Tyrnävä Lakeus region, currently based in Oulu, Finland, studying media at Oulu University of Applied Sciences. I began photography in 2014, and over the past decade, my camera has become an inseparable part of my everyday life.</p>
              <p style="margin-top: 0.85rem;">My visual approach draws on organic tones, natural light, and a timeless, film-inspired aesthetic translated into digital imagery. I focus on documentary street photography, portraits, artistic photography, and event coverage (such as the Qstock Festival). Alongside my creative work, I actively mentor and guide others in photography fundamentals.</p>
            </>
          ) : (
            <>
              <p>Olen 21-vuotias valokuvaaja, joka on varttunut Tyrnävän Lakeuden seudulla ja asuu nykyään Oulussa. Opiskelen tällä hetkellä medianomiksi Oulun ammattikorkeakoulussa. Aloitin valokuvauksen vuonna 2014, ja vuosikymmenen aikana kamerasta on tullut erottamaton osa arkeani.</p>
              <p style="margin-top: 0.85rem;">Kuvaustyylini ammentaa orgaanisista sävyistä, luonnonvalosta ja analogisen ajattoman estetiikan yhdistämisestä digitaaliseen ilmaisuun. Työskentelen erityisesti dokumentaarisen katukuvauksen, muotokuvien ja taidekuvauksen parissa sekä taltioin tapahtumia (kuten Qstock-festivaalia). Oman kuvaamiseni ohella opastan ja autan mielelläni muita valokuvauksen ja kameratekniikan parissa.</p>
            </>
          )}
        </div>
        <div class="jd-about-section">
          <h2>{lang === 'en' ? 'Awards and Recognitions' : 'Palkinnot ja tunnustukset'}</h2>
          <ul>
            <li>
              {lang === 'en' ? (
                <><strong>Hasselblad Masters 2026</strong>: Finalist in Project//21 category.</>
              ) : (
                <><strong>Hasselblad Masters 2026</strong>: Finalisti Project//21 -kategoriassa.</>
              )}
            </li>
            <li>
              {lang === 'en' ? (
                <><strong>SAKUstars 2023</strong>: Honorable mention in "Photographic Art in a Day".</>
              ) : (
                <><strong>SAKUstars 2023</strong>: Kunniamaininta sarjassa "Valokuvataidetta päivässä".</>
              )}
            </li>
          </ul>
          <a href="https://www.hasselblad.com/inspiration/masters/2026/" target="_blank" rel="noopener noreferrer" class="jd-about-badge-link" aria-label="Hasselblad Masters 2026 Finalist">
            <img src="/assets/thumbnails/badge_desktop.webp" alt="Hasselblad Masters 2026 Finalist" class="jd-about-badge-img" loading="lazy" width="128" height="106" />
            <div class="jd-about-badge-text">
              <span class="jd-about-badge-title">Hasselblad Masters 2026</span>
              <span class="jd-about-badge-sub">
                Project//21 Finalist
                <svg class="jd-badge-arrow" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </span>
            </div>
          </a>
        </div>
        <div class="jd-about-section">
          <h2>{lang === 'en' ? 'Exhibitions & Projects' : 'Näyttelyt ja projektit'}</h2>
          <ul>
            <li>{lang === 'en' ? <><strong>Exhibitions</strong>: Exhibited at Piippolan Könkkölä and Kestilä Library 2023–2024.</> : <><strong>Näyttelyt</strong>: Teoksiani on ollut esillä Piippolan Könkkölässä sekä Kestilän kirjastossa vuosina 2023 ja 2024.</>}</li>
          </ul>
        </div>
        <div class="jd-about-section jd-about-contact">
          <h2>{lang === 'en' ? 'Contact & Inquiries' : 'Yhteydenotto & Tiedustelut'}</h2>
          <p style="font-size: 1.05rem; margin-bottom: 0.4rem;">
            <a href="mailto:info@aatualatalo.com" style="text-decoration: underline; text-underline-offset: 4px; font-weight: 500;">
              info@aatualatalo.com
            </a>
          </p>
          <p style="font-size: 0.92rem; opacity: 0.75; margin: 0; line-height: 1.5;">
            {lang === 'en' ? 'Oulu & Northern Ostrobothnia — Available for assignments, workshops, and collaborations across Finland by arrangement.' : 'Oulu & Pohjois-Pohjanmaa — Saatavilla toimeksiantoihin, opetukseen ja yhteistöihin myös valtakunnallisesti sopimuksen mukaan.'}
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Shutter curtain -->
  <div id="jd-shutter-container">
    <div class="jd-curtain-primary"></div>
  </div>
  <div class="jd-shutter-title">{catLabel}</div>

  <!-- Mobile thumbs top bar -->
  <div id="jd-thumbs-header" class="jd-thumbs-header" aria-hidden="true">
    <div class="jd-thumbs-header-inner">
      <span class="jd-thumbs-header-title">{lang === 'en' ? 'Thumbs' : 'Kuvasto'}</span>
    </div>
  </div>

  <!-- Global thumbs panel (all categories) -->
  <div id="jd-thumbs-panel">
    <div class="jd-thumbs-inner">
      {allCats.map(({ key, data }) => {
        const catUrl = getCatUrl(key, lang);
        return data && data.length > 0 ? (
          <div class="jd-thumbs-section" id={`jd-thumbs-section-${key}`}>
            <div class="jd-thumbs-section-title">{catLabels[key] || key}</div>
            <div class="jd-thumbs-grid">
              {data.filter((item: any) => key === 'work4' || item.tyyppi !== 'teksti').map((item: any, idx: number) => {
                const itemKey = item.kuva || (item.layout === 'diptych' && item.images ? item.images.map((i: any) => i.kuva).join('|') : (item.otsikko ? `text_${item.otsikko}` : `item_${idx}`));
                if (item.tyyppi === 'teksti') {
                  const titleVal = item.otsikko || '';
                  const parseField = (val: any) => {
                    if (val === undefined || val === null || val === '') return '';
                    const str = String(val);
                    if (str.includes(' / ')) {
                      const parts = str.split(' / ');
                      return lang === 'fi' ? parts[0]?.trim() : parts.slice(1).join(' / ').trim();
                    }
                    return str;
                  };
                  const tStr = parseField(titleVal);
                  return (
                    <div class="jd-thumb-global jd-thumb-text" data-cat={key} data-cat-label={catLabels[key] || key} data-key={itemKey} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                      <div class="jd-thumb-text-inner">
                        <h3>{tStr}</h3>
                      </div>
                    </div>
                  );
                }
                if (item.layout === 'diptych' && item.images) {
                  const sub = item.images[0];
                  if (!sub) return null;
                  const fn = sub.kuva.split('/').pop().split('.')[0];
                  const mob = `${fn}_mobile.webp`;
                  const srcMob = sub.kuva.includes('http')
                    ? sub.kuva
                    : `/assets/thumbnails/${mob}`;
                  return (
                    <div class="jd-thumb-global" data-cat={key} data-cat-label={catLabels[key] || key} data-key={itemKey} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                      <img src={srcMob} loading="lazy" alt={sub.alt_text || ''}>
                    </div>
                  );
                }
                const fn = item.kuva.split('/').pop().split('.')[0];
                const mob = `${fn}_mobile.webp`;
                const srcMob = item.kuva.includes('http')
                  ? item.kuva
                  : `/assets/thumbnails/${mob}`;
                return (
                  <div class="jd-thumb-global" data-cat={key} data-cat-label={catLabels[key] || key} data-key={itemKey} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                    <img src={srcMob} loading="lazy" alt={item.alt_text || ''}>
                  </div>
                );
              })}
            </div>
          </div>
        ) : null;
      })}
    </div>
  </div>

  <!-- Floating close button for Kuvasto (Thumbs) -->
  <button id="jd-thumbs-close-btn" class="jd-floating-close-btn" onclick="if(typeof closeThumbsView==='function')closeThumbsView();" aria-label={lang === 'fi' ? 'Sulje kuvasto' : 'Close overview'}>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
  </button>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const metaEl = document.getElementById('jd-meta');
    const meta = metaEl ? JSON.parse(metaEl.textContent) : {};
    const { catLabel, categorySlug, isEventsCategory } = meta;

    const data = JSON.parse(document.getElementById('jd-data').textContent);
    const total = data.length;

    const slideshow = document.getElementById('jd-slideshow');
    const thumbsPanel = document.getElementById('jd-thumbs-panel');
    const counterNum = document.getElementById('jd-counter-num');
    const cursor = document.getElementById('jd-cursor-custom');
    const shutter = document.querySelector('.jd-curtain-primary');
    const shutterTitle = document.querySelector('.jd-shutter-title');

    if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);

    const slides = [];
    let current = 0;
    let thumbsOpen = false;

    const hash = window.location.hash;
    if (hash && hash.startsWith('#img-')) {
      const idx = parseInt(hash.replace('#img-', ''), 10);
      if (!isNaN(idx) && idx >= 0 && idx < total) current = idx;
    }

    function createSlide(item, i) {
      const slide = document.createElement('div');
      slide.className = 'jd-slide' + (i === current ? ' active' : '');
      if (item.type === 'text') {
        slide.className += ' jd-text-slide';
        const content = document.createElement('div');
        if (item.kartta) {
          content.className = 'jd-text-content jd-postcard-content';
          if (item.title) {
            const h2 = document.createElement('h2');
            h2.textContent = item.title;
            content.appendChild(h2);
          }
          if (item.text) {
            const p = document.createElement('p');
            p.textContent = item.text;
            content.appendChild(p);
          }
          if (window.L) {
            const mapContainer = document.createElement('div');
            mapContainer.className = 'jd-postcard-map';
            content.appendChild(mapContainer);
            
            setTimeout(() => {
              const map = L.map(mapContainer, {
                center: item.kartta.center || [60, 25],
                zoom: item.kartta.zoom || 8,
                zoomControl: false,
                dragging: false,
                touchZoom: false,
                doubleClickZoom: false,
                scrollWheelZoom: false,
                boxZoom: false,
                keyboard: false
              });
              L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO'
              }).addTo(map);
              
              if (item.kartta.points && item.kartta.points.length > 0) {
                const dotIcon = L.divIcon({ className: 'jd-map-dot-wrapper', html: '<div class="jd-map-dot"></div>', iconSize: [14, 14] });
                const bounds = L.latLngBounds();
                item.kartta.points.forEach(pt => {
                  const coords = pt.latlng || pt;
                  bounds.extend(coords);
                  const marker = L.marker(coords, { icon: dotIcon }).addTo(map);
                  if (pt.nimi) {
                    marker.bindTooltip(pt.nimi, {
                      permanent: true,
                      direction: 'top',
                      className: 'jd-map-tooltip',
                      offset: [0, -5],
                      opacity: 1
                    });
                  }
                });
                map.fitBounds(bounds, { padding: [40, 40], maxZoom: 10 });
              }
            }, 300);
          }
        } else {
          content.className = 'jd-editorial-content';
          if (item.title) {
            const h2 = document.createElement('h2');
            h2.textContent = item.title;
            content.appendChild(h2);
          }
          if (item.text) {
            const p = document.createElement('p');
            p.textContent = item.text;
            content.appendChild(p);
          }
        }
        slide.appendChild(content);
      } else if (item.layout === 'diptych' && item.images) {
        slide.className += ' jd-diptych-slide';
        item.images.forEach(imgData => {
          const picture = document.createElement('picture');
          
          // 1. Retina-näytöille & giganttisille näytöille ladataan alkuperäinen Master (WebP) 
          // jotta kuva on absoluuttisen terävä (esim. MacBook M2 Pro).
          const retinaSrc = document.createElement('source');
          retinaSrc.type = 'image/webp';
          retinaSrc.media = '(min-width: 1600px), (-webkit-min-device-pixel-ratio: 1.5) and (min-width: 801px)';
          retinaSrc.srcset = imgData.full;
          picture.appendChild(retinaSrc);

          // 2. Tavallisille desktop-näytöille (ei-retina, 801-1599px) ladataan uusi nopea 1600px AVIF
          if (imgData.srcAvif) {
            const avifSrc = document.createElement('source');
            avifSrc.type = 'image/avif';
            avifSrc.media = '(min-width: 801px)';
            avifSrc.srcset = imgData.srcAvif;
            picture.appendChild(avifSrc);
          }
          
          // 3. Fallback & mobiililaitteet: selaimen automaattisesti valitsema koko 
          const webpSrc = document.createElement('source');
          webpSrc.type = 'image/webp';
          webpSrc.srcset = imgData.srcset;
          webpSrc.sizes = '(max-width: 768px) 100vw, 50vw';
          picture.appendChild(webpSrc);
          
          const img = document.createElement('img');
          img.src = imgData.src;
          img.alt = imgData.alt || '';
          img.loading = (i === current || i === current + 1) ? 'eager' : 'lazy';
          img.onerror = () => { picture.querySelectorAll('source').forEach(s => s.remove()); img.src = imgData.full; };
          picture.appendChild(img);
          slide.appendChild(picture);
        });
        if (item.place) {
          const locEl = document.createElement('div');
          locEl.className = 'jd-slide-location';
          locEl.textContent = item.place;
          slide.appendChild(locEl);
        }
      } else {
        const picture = document.createElement('picture');
        
        // 1. Retina-näytöille & giganttisille näytöille ladataan alkuperäinen Master (WebP) 
        // jotta kuva on absoluuttisen terävä (esim. MacBook M2 Pro).
        const retinaSrc = document.createElement('source');
        retinaSrc.type = 'image/webp';
        retinaSrc.media = '(min-width: 1600px), (-webkit-min-device-pixel-ratio: 1.5) and (min-width: 801px)';
        retinaSrc.srcset = item.full;
        picture.appendChild(retinaSrc);

        // 2. Tavallisille desktop-näytöille (ei-retina, 801-1599px) ladataan uusi nopea 1600px AVIF
        if (item.srcAvif) {
          const avifSrc = document.createElement('source');
          avifSrc.type = 'image/avif';
          avifSrc.media = '(min-width: 801px)';
          avifSrc.srcset = item.srcAvif;
          picture.appendChild(avifSrc);
        }
        
        // 3. Fallback & mobiililaitteet: selaimen automaattisesti valitsema koko 
        const webpSrc = document.createElement('source');
        webpSrc.type = 'image/webp';
        webpSrc.srcset = item.srcset;
        webpSrc.sizes = '(max-width: 600px) 800px, (max-width: 1400px) 1600px, 3000px';
        picture.appendChild(webpSrc);
        
        const img = document.createElement('img');
        img.src = item.src;
        img.alt = item.alt || '';
        img.loading = (i === current || i === current + 1) ? 'eager' : 'lazy';
        img.onerror = () => { picture.querySelectorAll('source').forEach(s => s.remove()); img.src = item.full; };
        picture.appendChild(img);
        slide.appendChild(picture);

        if (item.place) {
          const locEl = document.createElement('div');
          locEl.className = 'jd-slide-location';
          locEl.textContent = item.place;
          slide.appendChild(locEl);
        }
      }
      return slide;
    }

    data.forEach((item, i) => {
      const slide = createSlide(item, i);
      slideshow.appendChild(slide);
      slides.push(slide);
    });

    /* Filter */
    const filterContainer = document.getElementById('jd-filter-dropdown-container');
    const filterToggle = document.getElementById('jd-filter-toggle');
    const filterMenu = document.getElementById('jd-filter-menu');
    let uniqueSeries = [...new Set(data.map(item => item.series))].filter(s => s && s !== 'all');
    let currentFilter = 'all';
    let visibleIndices = data.map((_, i) => i);
    let visibleTotal = visibleIndices.length;

    if (uniqueSeries.length > 1 && filterContainer && (isEventsCategory || categorySlug === 'recent')) {
      filterContainer.classList.add('is-visible');
      const btnAll = document.createElement('button');
      btnAll.className = 'jd-filter-btn active'; btnAll.textContent = meta.lang === 'fi' ? 'KAIKKI' : 'ALL';
      btnAll.dataset.filter = 'all'; filterMenu.appendChild(btnAll);
      uniqueSeries.forEach(s => {
        const btn = document.createElement('button');
        btn.className = 'jd-filter-btn'; btn.textContent = s.toUpperCase().replace(/-/g, ' ');
        btn.dataset.filter = s; filterMenu.appendChild(btn);
      });
      filterToggle.addEventListener('click', e => { e.stopPropagation(); filterMenu.classList.toggle('is-open'); filterToggle.classList.toggle('is-open'); });
      document.addEventListener('click', e => { if (!filterContainer.contains(e.target)) { filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); } });
      filterMenu.addEventListener('click', e => { if (e.target.tagName === 'BUTTON') { const f = e.target.dataset.filter; filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); if (f !== currentFilter) applyFilter(f); } });
    }

    function applyFilter(filter) {
      currentFilter = filter;
      visibleIndices = [];
      data.forEach((item, i) => { if (filter === 'all' || item.series === filter) visibleIndices.push(i); });
      visibleTotal = visibleIndices.length;
      document.querySelectorAll('.jd-filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
      let newCurrent = visibleIndices.includes(current) ? current : visibleIndices[0];
      if (newCurrent === undefined) newCurrent = 0;
      goToAbsolute(newCurrent, true);
    }

    /* Thumbs listeners */
    document.querySelectorAll('.jd-thumb-global').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const cat = thumb.getAttribute('data-cat');
        const idx = parseInt(thumb.getAttribute('data-idx'), 10);
        const url = thumb.getAttribute('data-url');
        if (cat === categorySlug) { goToAbsolute(idx); closeThumbsView(); }
        else goToCategory(url);
      });
    });

    function updateCounter() {
      let vi = visibleIndices.indexOf(current);
      if (vi === -1) vi = 0;
      const n = vi + 1;

      const catSpan = document.getElementById('jd-counter-cat');
      if (catSpan) {
        catSpan.textContent = catLabel;
        catSpan.style.opacity = '1';
      }

      if (document.getElementById('jd-counter-num')) document.getElementById('jd-counter-num').textContent = n;
      if (document.getElementById('jd-counter-tot')) document.getElementById('jd-counter-tot').textContent = visibleTotal;
      const restSpan = document.getElementById('jd-counter-rest');
      if (restSpan) restSpan.style.opacity = '1';

      const placeEl = document.getElementById('jd-counter-place');
      if (placeEl) {
        const curItem = data[current];
        if (curItem && curItem.place) {
          placeEl.textContent = curItem.place;
          placeEl.style.display = 'block';
        } else {
          placeEl.textContent = '';
          placeEl.style.display = 'none';
        }
      }

      const cursorText = document.getElementById('jd-cursor-text');
      if (cursorText) cursorText.textContent = `${catLabel} — ${n} / ${visibleTotal}`;
    }
    updateCounter();

    /* Navigation */
    function goToCategory(url, titleText = '') {
      if (document.body.classList.contains('is-leaving')) return;
      
      let delay = 0;
      if (document.body.classList.contains('index-is-open') && typeof window.closeIndexPanel === 'function') {
        window.closeIndexPanel();
        delay = 400;
      }
      if (document.body.classList.contains('about-is-open') && typeof window.closeAboutPanel === 'function') {
        window.closeAboutPanel();
        delay = 400;
      }

      setTimeout(() => {
        if (titleText && shutterTitle) {
          shutterTitle.textContent = titleText;
          document.body.classList.remove('hide-shutter-title');
          shutterTitle.classList.remove('trigger-title-enter');
          void shutterTitle.offsetWidth; // force reflow
          shutterTitle.classList.add('trigger-title-enter');
        } else {
          document.body.classList.add('hide-shutter-title');
        }
        document.body.classList.remove('is-entering-ready');
        document.body.classList.add('prepare-leave');
        void document.body.offsetWidth;
        document.body.classList.remove('prepare-leave');
        document.body.classList.add('is-leaving');
        let triggered = false;
        const handler = () => { triggered = true; window.location.href = url; };
        shutter.addEventListener('transitionend', handler, { once: true });
        setTimeout(() => { if (!triggered) window.location.href = url; }, 1600);
      }, delay);
    }

    document.addEventListener('click', e => {
      const link = e.target.closest('a');
      if (link && link.href) {
        const urlObj = new URL(link.href, window.location.origin);
        if (urlObj.origin === window.location.origin && !link.hasAttribute('download') && link.target !== '_blank') {
          if (urlObj.pathname !== window.location.pathname || urlObj.search !== window.location.search) {
            e.preventDefault();
            
            let titleText = '';
            const spanText = link.querySelector('span:not(.jd-count)');
            if (spanText) titleText = spanText.textContent.trim();
            else if (link.classList.contains('jd-filter-btn')) titleText = link.textContent.trim();
            else {
              const textNode = Array.from(link.childNodes).find(n => n.nodeType === 3 && n.textContent.trim().length > 0);
              if (textNode) titleText = textNode.textContent.trim();
            }
            
            goToCategory(link.href, titleText);
          }
        }
      }
    });

    function goToRelative(step, allowCategorySwitch = true) {
      if (visibleTotal === 0) return;
      let cvi = visibleIndices.indexOf(current);
      if (cvi === -1) cvi = 0;
      const nvi = cvi + step;
      if (nvi >= 0 && nvi < visibleTotal) {
        goToAbsolute(visibleIndices[nvi]);
      } else if (nvi >= visibleTotal) {
        if (allowCategorySwitch) {
          const nextUrl = document.getElementById('jd-next-url');
          if (nextUrl) goToCategory(nextUrl.textContent, nextUrl.getAttribute('data-cat-label') || '');
        }
      } else {
        if (allowCategorySwitch) {
          const prevUrl = document.getElementById('jd-prev-url');
          if (prevUrl) goToCategory(prevUrl.textContent, prevUrl.getAttribute('data-cat-label') || '');
        }
      }
    }

    function goToAbsolute(idx, skipFilterCheck = false) {
      if (visibleTotal === 0) return;
      if (!skipFilterCheck && !visibleIndices.includes(idx)) applyFilter('all');
      if (slides[current]) slides[current].classList.remove('active');
      const localThumbs = document.querySelectorAll(`.jd-thumb-global[data-cat="${categorySlug}"]`);
      if (localThumbs[current]) localThumbs[current].classList.remove('is-active');
      current = idx;
      if (slides[current]) slides[current].classList.add('active');
      if (localThumbs[current]) localThumbs[current].classList.add('is-active');
      updateCounter();
      if (window.history && window.history.replaceState) {
        const newUrl = idx === 0 
          ? window.location.pathname + window.location.search 
          : `${window.location.pathname}${window.location.search}#img-${idx}`;
        window.history.replaceState(null, '', newUrl);
      }
      let vi = visibleIndices.indexOf(current);
      if (vi !== -1) {
        // Puskurointi: 2 eteenpäin + 1 taaksepäin
        const preloadIdxs = [
          visibleIndices[(vi + 1) % visibleTotal],
          visibleIndices[(vi + 2) % visibleTotal],
          visibleIndices[(vi - 1 + visibleTotal) % visibleTotal],
        ].filter(ix => ix !== undefined);
        preloadIdxs.forEach(ix => {
          const slide = slides[ix];
          if (!slide) return;
          const img = slide.querySelector('img');
          if (!img) return;
          // Aseta eager jos ei vielä ladattu
          if (!img.complete) img.loading = 'eager';
          // Käytetään currentSrc (selaimen valitsema formaatti) || src varalogiikkana:
          // Jos slide on piilossa (display:none), selain ei välttämättä ole asettanut
          // currentSrc-kenttää vielä – tässä tapauksessa img.src toimii varalogiikkana.
          const targetSrc = img.currentSrc || img.src;
          if (targetSrc && !slide.dataset.preloaded) {
            fetch(targetSrc, { priority: 'low' }).catch(() => {});
            slide.dataset.preloaded = '1';
          }
        });
      }
    }

    /* Touch */
    let touchStartX = 0, touchStartY = 0, touchStartTime = 0, hasSwiped = false, isDraggingMenu = false, menuCurrentDrag = 0, swipeIntentDetermined = false;
    slideshow.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY; touchStartTime = Date.now(); hasSwiped = false;
      swipeIntentDetermined = false; isDraggingMenu = false; menuCurrentDrag = 0;
      if (touchStartX < 30) return; // Allow Safari edge swipe
      document.body.classList.add('user-has-interacted');
    }, { passive: true });
    
    slideshow.addEventListener('touchmove', e => {
      if (touchStartX < 30) return;
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - touchStartY);
      
      // Vasta selkeä liike (> 25px) tulkitaan pyyhkäisyksi, jottei pieni sormen värähdys estä napautusta
      if (!swipeIntentDetermined && (dx > 25 || dy > 25)) {
        swipeIntentDetermined = true;
        hasSwiped = true;
      }
      
      if (swipeIntentDetermined && dx > dy) {
        if (e.cancelable) e.preventDefault();
      }
    }, { passive: false });
    
    slideshow.addEventListener('touchend', e => {
      if (touchStartX < 30) return;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = Math.abs(e.changedTouches[0].clientY - touchStartY);
      
      if (Math.abs(dx) > 45 && Math.abs(dx) > dy && !document.body.classList.contains('index-is-open')) {
        dx < 0 ? goToRelative(1) : goToRelative(-1);
      }
    }, { passive: true });

    slideshow.addEventListener('click', e => {
      if (hasSwiped) { hasSwiped = false; return; }
      if (e.target.closest('.jd-postcard-map')) return;
      
      // Napautuksen aikaraja 450ms: sormen lepuutus ruudulla (> 450ms) ei vaihda kuvaa
      if (touchStartTime && (Date.now() - touchStartTime > 450)) {
        touchStartTime = 0;
        return;
      }
      
      document.body.classList.add('user-has-interacted');
      if (thumbsOpen) return;

      const isTouchOrMobile = window.innerWidth <= 800 || ('ontouchstart' in window);
      if (isTouchOrMobile) {
        if (e.clientX < window.innerWidth * 0.38) {
          goToRelative(-1);
        } else {
          goToRelative(1);
        }
      } else {
        e.clientX > window.innerWidth / 2 ? goToRelative(1) : goToRelative(-1);
      }
    });

    document.querySelectorAll('.jd-hint-arrow.left').forEach(el => {
      el.addEventListener('click', e => {
        e.stopPropagation();
        if ('vibrate' in navigator) navigator.vibrate(10);
        goToRelative(-1);
      });
    });
    document.querySelectorAll('.jd-hint-arrow.right').forEach(el => {
      el.addEventListener('click', e => {
        e.stopPropagation();
        if ('vibrate' in navigator) navigator.vibrate(10);
        goToRelative(1);
      });
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft' || e.key === ' ') document.body.classList.add('user-has-interacted');
      if (thumbsOpen && e.key === 'Escape') { closeThumbsView(); return; }
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); goToRelative(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goToRelative(-1); }
    });

    window.addEventListener('hashchange', () => {
      const h = window.location.hash;
      if (h && h.startsWith('#img-')) {
        const targetIdx = parseInt(h.replace('#img-', ''), 10);
        if (!isNaN(targetIdx) && targetIdx >= 0 && targetIdx < total && targetIdx !== current) {
          goToAbsolute(targetIdx);
        }
      } else if (!h && current !== 0) {
        goToAbsolute(0);
      }
    });

    /* Wheel to open/close index feature removed */

    /* Cursor Physics (Instant) */
    if ('ontouchstart' in window) { if (cursor) cursor.style.display = 'none'; document.body.style.cursor = 'auto'; }
    if (!window.matchMedia('(pointer: coarse)').matches) {
      document.body.style.cursor = 'none';
      
      document.addEventListener('mousemove', e => {
        sessionStorage.setItem('jdLastMouseX', e.clientX);
        sessionStorage.setItem('jdLastMouseY', e.clientY);
        if (window.jdCursorFrozen) return;

        if (document.body.classList.contains('index-is-open') || document.body.classList.contains('about-is-open') || thumbsOpen) { 
          if (cursor) cursor.style.opacity = '0'; 
          document.body.style.cursor = 'auto'; 
          return; 
        }
        
        const target = e.target;
        const isNav = target.closest('#jd-bottom-nav') || target.closest('#jd-index-panel') || target.closest('#jd-thumbs-close') || target.closest('#jd-thumbs-header');
        const nearBottom = e.clientY > window.innerHeight - 100;
        
        if (isNav || nearBottom) { 
          cursor.style.opacity = '0'; 
          document.body.style.cursor = 'auto'; 
        } else {
          cursor.style.left = e.clientX + 'px';
          cursor.style.top = e.clientY + 'px';
          cursor.style.opacity = '1'; 
          document.body.style.cursor = 'none';
          const arrowEl = document.getElementById('jd-cursor-arrow');
          if (arrowEl) arrowEl.textContent = e.clientX > window.innerWidth / 2 ? '→' : '←';
        }
      });
      
      document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; });
    }

    /* Thumbs view */
    function openThumbsView() {
      if (thumbsOpen) return;
      
      thumbsOpen = true; 
      document.body.classList.add('thumbs-is-open');
      if (cursor) cursor.style.display = 'none';
      document.body.style.cursor = 'auto';
      thumbsPanel.classList.add('is-open');
      document.getElementById('jd-normal-nav').style.display = 'none';
      
      const thumbsNav = document.getElementById('jd-thumbs-nav');
      thumbsNav.style.animation = 'none';
      void thumbsNav.offsetWidth;
      thumbsNav.classList.add('is-open');
      thumbsNav.style.animation = '';
      
      if (typeof window.closeIndexPanel === 'function') window.closeIndexPanel();
      const currentCatSection = document.getElementById(`jd-thumbs-section-${categorySlug}`);
      if (currentCatSection) {
        const currentThumb = currentCatSection.querySelectorAll('.jd-thumb-global')[current];
        if (currentThumb) { document.querySelectorAll('.jd-thumb-global.is-active').forEach(el => el.classList.remove('is-active')); currentThumb.classList.add('is-active'); }
        currentCatSection.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
      const hintArrows = document.getElementById('jd-hint-arrows');
      if (hintArrows) hintArrows.style.opacity = '0';
      const thumbsHeader = document.getElementById('jd-thumbs-header');
      if (thumbsHeader) thumbsHeader.setAttribute('aria-hidden', 'false');
    }
    
    function closeThumbsView() {
      if (!thumbsOpen) return;
      
      thumbsOpen = false; 
      document.body.classList.remove('thumbs-is-open');
      if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
        if (cursor) cursor.style.display = '';
        document.body.style.cursor = 'none';
      }
      thumbsPanel.classList.remove('is-open');
      document.getElementById('jd-normal-nav').style.display = 'flex';
      document.getElementById('jd-thumbs-nav').classList.remove('is-open');
      
      const hintArrows = document.getElementById('jd-hint-arrows');
      if (hintArrows) hintArrows.style.opacity = '1';
      const thumbsHeader = document.getElementById('jd-thumbs-header');
      if (thumbsHeader) thumbsHeader.setAttribute('aria-hidden', 'true');
    }
    document.getElementById('jd-thumbs-btn')?.addEventListener('click', openThumbsView);
    document.getElementById('jd-thumbs-close')?.addEventListener('click', closeThumbsView);
    document.getElementById('jd-thumbs-close-btn')?.addEventListener('click', closeThumbsView);
    document.getElementById('jd-thumbs-close-top')?.addEventListener('click', closeThumbsView);

    /* Index button */
    document.getElementById('jd-index-btn-bottom')?.addEventListener('click', e => {
      e.stopPropagation();
      if (typeof window.openIndexPanel === 'function') {
        const panel = document.getElementById('jd-index-panel');
        panel?.classList.contains('is-open') ? window.closeIndexPanel() : window.openIndexPanel();
      }
    });

    /* Mobile counter click/tap to open menu */
    const counterEl = document.getElementById('jd-counter');
    counterEl?.addEventListener('click', e => {
      e.stopPropagation();
      if (typeof window.openIndexPanel === 'function') {
        const panel = document.getElementById('jd-index-panel');
        panel?.classList.contains('is-open') ? window.closeIndexPanel() : window.openIndexPanel();
      }
    });
    counterEl?.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (typeof window.openIndexPanel === 'function') window.openIndexPanel();
      }
    });

    /* Page entrance animation */
    function startPageOpen() {
      if (shutterTitle) {
        const isMobile = window.innerWidth <= 800;
        if (!isMobile) {
          const lastX = sessionStorage.getItem('jdLastMouseX');
          const lastY = sessionStorage.getItem('jdLastMouseY');
          if (lastX && lastY && cursor) { 
            cursor.style.left = lastX + 'px'; cursor.style.top = lastY + 'px'; 
            cursor.style.opacity = '0'; document.body.style.cursor = 'none'; 
            shutterTitle.style.setProperty('--target-x', lastX + 'px');
            shutterTitle.style.setProperty('--target-y', lastY + 'px');
            window.jdCursorFrozen = true;
            setTimeout(() => {
              window.jdCursorFrozen = false;
              cursor.style.opacity = '1';
            }, 2800);
          }
        } else {
          const catSpan = document.getElementById('jd-counter-cat');
          const counterRest = document.getElementById('jd-counter-rest');
          if (catSpan && counterRest) {
            // Calculate immediately so CSS vars are ready before class is added
            const rect = catSpan.getBoundingClientRect();
            if (rect.width > 0) {
              const targetX = rect.left + rect.width / 2;
              const targetY = rect.top + rect.height / 2;
              shutterTitle.style.setProperty('--target-x', targetX + 'px');
              shutterTitle.style.setProperty('--target-y', targetY + 'px');
            } else {
              shutterTitle.style.setProperty('--target-x', '50%');
              shutterTitle.style.setProperty('--target-y', 'calc(100dvh - 59px)');
            }
            setTimeout(() => {
              catSpan.style.transition = 'opacity 0.6s ease';
              catSpan.style.opacity = '1';
              counterRest.style.transition = 'opacity 0.6s ease';
              counterRest.style.opacity = '1';
            }, 2200);
          }
        }
      }
      setTimeout(() => {
        document.body.classList.add('is-entering-ready');
        if (!sessionStorage.getItem('jd-hints-seen')) {
          const hintArrows = document.getElementById('jd-hint-arrows');
          if (hintArrows) hintArrows.classList.add('show-hints');
          sessionStorage.setItem('jd-hints-seen', 'true');
        }
      }, 50);
    }

    document.body.classList.add('show-shutter-title');
    let isLoaded = document.readyState === 'complete', isMinTimePassed = false, hasOpened = false;
    window.addEventListener('load', () => { isLoaded = true; tryOpen(); });
    setTimeout(() => { isMinTimePassed = true; tryOpen(); }, 200);
    function tryOpen() { if (!hasOpened && isLoaded && isMinTimePassed) { hasOpened = true; startPageOpen(); } }
    setTimeout(() => { if (!hasOpened) { hasOpened = true; startPageOpen(); } }, 3000);

    /* Index panel open/close (global) */
    const indexPanel = document.getElementById('jd-index-panel');
    const indexOverlay = document.getElementById('jd-index-overlay');
    const jdMain = document.getElementById('jd-main');

    // Index desktop hover preview logic (Dual Layer Smooth Crossfade)
    const imgA = document.getElementById('jd-index-preview-img-a');
    const imgB = document.getElementById('jd-index-preview-img-b');
    const indexLinks = document.querySelectorAll('.jd-index-link');

    if (imgA && imgB && indexLinks.length > 0) {
      let currentLayer = 'a'; // 'a' or 'b'
      let activeSrc = '';
      let switchTimeout = null;
      let hideTimeout = null;

      function setPreviewImage(src) {
        if (!src || src === activeSrc) return;
        activeSrc = src;

        const nextImg = currentLayer === 'a' ? imgB : imgA;
        const currentImg = currentLayer === 'a' ? imgA : imgB;

        nextImg.src = src;
        requestAnimationFrame(() => {
          nextImg.classList.add('is-active');
          currentImg.classList.remove('is-active');
          currentLayer = currentLayer === 'a' ? 'b' : 'a';
        });
      }

      // Ennakkolataus: fetch() toimii kaikissa selaimissa, myös Safarissa
      // (link rel="prefetch" ei tue Safari – käytetään fetch()-pohjaista ratkaisua)
      function prefetchPage(url) {
        if (!url || url.startsWith('#')) return;
        if (document.querySelector(`link[data-prefetched="${CSS.escape(url)}"]`)) return;
        const marker = document.createElement('link');
        marker.dataset.prefetched = url;
        document.head.appendChild(marker);
        fetch(url, { priority: 'low' }).catch(() => {});
      }

      indexLinks.forEach(link => {
        const src = link.getAttribute('data-preview-src');
        if (src) {
          const preloader = new Image();
          preloader.src = src;
        }

        link.addEventListener('mouseenter', () => {
          if (window.innerWidth <= 768) return;
          if (hideTimeout) { clearTimeout(hideTimeout); hideTimeout = null; }
          const targetSrc = link.getAttribute('data-preview-src');
          if (targetSrc && targetSrc !== activeSrc) {
            if (switchTimeout) clearTimeout(switchTimeout);
            switchTimeout = setTimeout(() => {
              setPreviewImage(targetSrc);
            }, 80);
          }
          // HTML-sivun ennakkolataus hover-hetkellä
          const href = link.getAttribute('href');
          if (href) prefetchPage(href);
        });

        // Mobiili: touchstart – sormi osuu linkkiin
        link.addEventListener('touchstart', () => {
          const href = link.getAttribute('href');
          if (href) prefetchPage(href);
        }, { passive: true });
      });

      indexPanel?.addEventListener('mouseleave', () => {
        hideTimeout = setTimeout(() => {
          imgA.classList.remove('is-active');
          imgB.classList.remove('is-active');
          activeSrc = '';
        }, 300);
      });
    }

    window.openIndexPanel = function() {
      if (typeof closeThumbsView === 'function') closeThumbsView();
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.add('is-open'); }
      indexOverlay?.classList.add('is-open'); document.body.classList.add('index-is-open');
      if (cursor) cursor.style.display = 'none';
      document.body.style.cursor = 'auto';
      if (indexPanel) indexPanel.scrollTop = 0;

      // Autoselect active category preview if available on desktop
      if (window.innerWidth > 768 && imgA) {
        const activeLink = document.querySelector('.jd-index-link.active');
        const activeSrc = activeLink?.getAttribute('data-preview-src');
        if (activeSrc) {
          imgA.src = activeSrc;
          requestAnimationFrame(() => {
            imgA.classList.add('is-active');
          });
        }
      }
    };
    window.closeIndexPanel = function() {
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.remove('parallax-ready'); indexPanel.classList.remove('is-open'); }
      indexOverlay?.classList.remove('is-open'); document.body.classList.remove('index-is-open');
      if (imgA) imgA.classList.remove('is-active');
      if (imgB) imgB.classList.remove('is-active');
      if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
        if (cursor) cursor.style.display = '';
        document.body.style.cursor = 'none';
      }
    };

    window.openAboutPanel = function() { 
      const p = document.getElementById('jd-about-panel'); 
      if (p) { 
        p.classList.add('is-open'); 
        document.body.classList.add('about-is-open'); 
        if (cursor) cursor.style.opacity = '0';
        document.body.style.cursor = 'auto';
        const n = document.getElementById('jd-normal-nav'); 
        if (n) n.style.display = 'none'; 
      } 
    };
    window.closeAboutPanel = function() { 
      const p = document.getElementById('jd-about-panel'); 
      if (p) { 
        p.classList.remove('is-open'); 
        document.body.classList.remove('about-is-open'); 
        const n = document.getElementById('jd-normal-nav'); 
        const tp = document.getElementById('jd-thumbs-panel'); 
        if (n && (!tp || !tp.classList.contains('is-open'))) n.style.display = 'flex'; 
        if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
          if (cursor && !document.body.classList.contains('index-is-open') && !thumbsOpen) {
            document.body.style.cursor = 'none';
          }
        }
      } 
    };

    indexOverlay?.addEventListener('click', () => window.closeIndexPanel());
    jdMain?.addEventListener('click', e => { if (e.target.closest('#jd-bottom-nav')) return; if (document.body.classList.contains('index-is-open')) window.closeIndexPanel(); });
    document.querySelectorAll('#jd-index-panel .jd-index-link.active').forEach(link => { link.addEventListener('click', e => { e.preventDefault(); window.closeIndexPanel(); }); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { window.closeIndexPanel(); window.closeAboutPanel(); closeThumbsView(); } });
  });
  </script>

  {import.meta.env.DEV && <CreativeToolbar categorySlug={categorySlug} lang={lang} />}
</body>
</html>