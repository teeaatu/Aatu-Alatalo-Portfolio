    }
    .jd-postcard-map .leaflet-container { background: #ffffff; }
    .jd-postcard-map .leaflet-layer { filter: contrast(0.96) opacity(0.9); }
    .jd-postcard-map .leaflet-control-attribution { display: none; }
    
    .jd-map-dot-wrapper { display: flex; align-items: center; justify-content: center; overflow: visible !important; }
    .jd-map-dot {
      width: 10px; height: 10px;
