          if (mobileScrollBlocked() || mobileFingerDown) return;
          const y = window.scrollY;
          stable = Math.abs(y - previous) < 0.5 ? stable + 1 : 0;
          previous = y;
          if (performance.now() - lastMobileScrollAt < 120) return;
          if (stable >= 3) commitMobileSlide();
          else mobileSettleFrame = requestAnimationFrame(check);
        };
        mobileSettleFrame = requestAnimationFrame(check);
      }, 120);
    }
    listen(window, 'scroll', () => {
      if (!mobileScrollReady || window.innerWidth > 800) return;
      lastMobileScrollAt = performance.now();
      if (!mobileScrollFrame) mobileScrollFrame = requestAnimationFrame(syncMobileSlide);
      scheduleMobileSettle();
    }, { passive: true });
    listen(window, 'scrollend', () => {
      // Some Safari versions emit an old scrollend when smooth scrolling is retargeted.
      const requested = mobileCentres.find(item => item.index === mobileRequestedIndex);
      if (requested && Math.abs(requested.centre - window.scrollY - window.innerHeight / 2) >= 3) return;
      commitMobileSlide();
    }, { passive: true });
    const mobilePanelObserver = new MutationObserver(() => {
      const open = document.body.matches('.index-is-open, .thumbs-is-open, .about-is-open');
      document.documentElement.classList.toggle('jd-mobile-panel-open', open);
      if (!mobilePanelOpen && open) {
        mobileRequestedIndex = mobileCentres[nearestMobilePosition()]?.index ?? current;
        clearMobilePhotoFocus();
      }
      if (mobilePanelOpen && !open) requestAnimationFrame(() => {
        rebuildMobileCentres();
        alignMobileSlide(mobileRequestedIndex ?? current, 'instant');
      });
      mobilePanelOpen = open;
    });
    mobilePanelObserver.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    observers.push(mobilePanelObserver);
    listen(window, 'jd:splash-dismissed', () => {
      if (window.innerWidth > 800) return;
      requestAnimationFrame(() => {
        rebuildMobileCentres();
        alignMobileSlide(mobileRequestedIndex ?? current, 'instant');
      });
    });
    const galleryResizeObserver = new ResizeObserver(scheduleMobileGeometry);
    galleryResizeObserver.observe(slideshow);
    observers.push(galleryResizeObserver);
    listen(window, 'resize', () => {
      const active = window.innerWidth <= 800;
      if (active !== mobileViewportActive) {
        mobileViewportActive = active;
        mobileRequestedIndex = null;
        mobileFingerDown = false;
        if (!active) clearMobilePhotoFocus();
        rebuildMobileCentres();
        if (active) alignMobileSlide(current, 'instant');
      }
      scheduleMobileGeometry();
    }, { passive: true });
    requestAnimationFrame(() => {
      rebuildMobileCentres();
      alignMobileSlide(current, 'instant');
      requestAnimationFrame(() => {
        mobileScrollReady = true;
        syncMobileSlide();
        scheduleMobileSettle();
      });
    });

    slideshow.addEventListener('touchstart', e => {
      mobileTouch = null;
      mobileFingerDown = true;
      mobileRequestedIndex = null;
      clearTimeout(mobileSettleTimer);
      cancelAnimationFrame(mobileSettleFrame);
      touchGestureIgnored = e.touches.length !== 1;
      if (touchGestureIgnored) return;
      const finger = e.touches[0];
      touchStartX = finger.clientX; touchStartY = finger.clientY;
      touchStartTime = Date.now(); hasSwiped = false; swipeIntentDetermined = false;
      if (touchStartX < 30) return;
      document.body.classList.add('user-has-interacted');
      if (window.innerWidth <= 800 && touchStartX < window.innerWidth - 30
        && !document.body.matches('.index-is-open, .thumbs-is-open, .about-is-open, .is-leaving')
        && !e.target.closest('.jd-postcard-map')) {
        const item = mobileCentres[nearestMobilePosition()];
        mobileTouch = {
          id: finger.identifier, axis: null, startIndex: item?.index ?? current,
          settled: item && Math.abs(item.centre - window.scrollY - window.innerHeight / 2) < 3
        };
      }
    }, { passive: true });

    slideshow.addEventListener('touchmove', e => {
      if (touchStartX < 30) return;
      if (e.touches.length !== 1) {
        mobileTouch = null;
        touchGestureIgnored = true;
        hasSwiped = true;
        return;
      }
      const finger = e.touches[0];
      const dx = finger.clientX - touchStartX;
      const dy = finger.clientY - touchStartY;
      if (mobileTouch) {
        if (!mobileTouch.axis && Math.max(Math.abs(dx), Math.abs(dy)) > 8) {
          mobileTouch.axis = Math.abs(dy) > Math.abs(dx) ? 'vertical' : 'horizontal';
        }
        if (mobileTouch.axis === 'vertical') {
          document.body.classList.add('mobile-has-scrolled');
          hasSwiped = true;
          return; // Safari owns the drag, momentum, toolbar motion and snap.
        }
      }
      if (!swipeIntentDetermined && (Math.abs(dx) > 25 || Math.abs(dy) > 25)) {
        swipeIntentDetermined = true;
        hasSwiped = true;
      }
      if (swipeIntentDetermined && Math.abs(dx) > Math.abs(dy) && e.cancelable) e.preventDefault();
    }, { passive: false });

    slideshow.addEventListener('touchend', e => {
      mobileFingerDown = e.touches.length > 0;
      scheduleMobileSettle();
      if (touchStartX < 30 || touchGestureIgnored) return;
      const gesture = mobileTouch;
      mobileTouch = null;
      if (gesture?.axis === 'vertical') {
        hasSwiped = true;
        const finger = Array.from(e.changedTouches).find(touch => touch.identifier === gesture.id);
        if (!finger) return;
        const dy = finger.clientY - touchStartY;
        const direction = dy < 0 ? 1 : -1;
        const index = visibleIndices.indexOf(gesture.startIndex);
        const outward = direction > 0 ? index === visibleTotal - 1 : index === 0;
        // A gesture arriving at the first/last work cannot leave its category.
        if (gesture.settled && outward && mobileNavigationIndex() === gesture.startIndex && Math.abs(dy) >= 60) {
          goToRelative(direction);
        }
        return;
      }
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = Math.abs(e.changedTouches[0].clientY - touchStartY);
      if (Math.abs(dx) > 45 && Math.abs(dx) > dy && !document.body.classList.contains('index-is-open')) {
        dx < 0 ? goToRelative(1) : goToRelative(-1);
      }
    }, { passive: true });

    slideshow.addEventListener('touchcancel', () => {
      mobileFingerDown = false;
      scheduleMobileSettle();
      mobileTouch = null;
      touchGestureIgnored = true;
      hasSwiped = true;
    }, { passive: true });
    listen(window, 'orientationchange', () => {
      mobileTouch = null;
      requestAnimationFrame(() => { rebuildMobileCentres(); alignMobileSlide(displayedIndex, 'instant'); });
    });

    slideshow.addEventListener('click', e => {
      if (hasSwiped) { hasSwiped = false; return; }
      if (e.target instanceof Element && e.target.closest('.jd-postcard-map, .jd-masters-info-trigger')) return;
      
      // Napautuksen aikaraja 450ms: sormen lepuutus ruudulla (> 450ms) ei vaihda kuvaa
      if (touchStartTime && (Date.now() - touchStartTime > 450)) {
        touchStartTime = 0;
        return;
      }
      
      document.body.classList.add('user-has-interacted');
      if (thumbsOpen) return;

      const isTouchOrMobile = window.innerWidth <= 800 || ('ontouchstart' in window);
      if (isTouchOrMobile) {
        if (e.clientX < window.innerWidth * 0.38) {
          goToRelative(-1);
        } else {
          goToRelative(1);
        }
      } else {
        e.clientX > window.innerWidth / 2 ? goToRelative(1) : goToRelative(-1);
      }
    });

    function bindHintArrow(selector, delta) {
      document.querySelectorAll(selector).forEach(el => {
        const trigger = e => {
          e.stopPropagation();
          if ('vibrate' in navigator) navigator.vibrate(10);
          goToRelative(delta);
        };
        el.addEventListener('click', trigger);
        el.addEventListener('keydown', e => {
          if (e.key === 'Enter') { e.preventDefault(); trigger(e); }
          else if (e.key === ' ') { e.preventDefault(); }
        });
        el.addEventListener('keyup', e => {
          if (e.key === ' ') trigger(e);
        });
      });
    }
    bindHintArrow('.jd-hint-arrow.left', -1);
    bindHintArrow('.jd-hint-arrow.right', 1);

    listen(document, 'keydown', e => {
      if (thumbsOpen && e.key === 'Escape') { closeThumbsView(); return; }
      if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey
        || document.body.matches('.index-is-open, .thumbs-is-open, .about-is-open, .is-leaving')) return;
      if (e.target instanceof Element && e.target.closest('dialog[open], input, textarea, select, [contenteditable], a, button')) return;

      const desktop = window.innerWidth > 800;
      const forward = e.key === 'ArrowRight' || (desktop && e.key === 'ArrowDown');
      const backward = e.key === 'ArrowLeft' || (desktop && e.key === 'ArrowUp');
      const space = e.key === ' ';
      if (!forward && !backward && !space) return;
      e.preventDefault();
      document.body.classList.add('user-has-interacted');
      goToRelative(backward ? -1 : 1, space);
    });

    listen(window, 'hashchange', () => {
      const h = window.location.hash;
      if (h && h.startsWith('#img-')) {
        const targetIdx = parseInt(h.replace('#img-', ''), 10);
        if (!isNaN(targetIdx) && targetIdx >= 0 && targetIdx < total && targetIdx !== current) {
          goToAbsolute(targetIdx);
        }
      } else if (!h && current !== 0) {
        goToAbsolute(0);
      }
    });

    /* Wheel to open/close index feature removed */

    /* Cursor Physics (Instant) */
    const cursorArrow = document.getElementById('jd-cursor-arrow');
    if ('ontouchstart' in window) { if (cursor) cursor.style.display = 'none'; document.body.style.cursor = 'auto'; }
    if (!window.matchMedia('(pointer: coarse)').matches) {
      document.body.style.cursor = 'none';
      
      listen(document, 'mousemove', e => {
        setWheelCounterVisible(false);
        lastMouseX = e.clientX;
        lastMouseY = e.clientY;
        if (window.jdCursorFrozen) return;

        if (document.body.classList.contains('index-is-open') || document.body.classList.contains('about-is-open') || thumbsOpen) { 
          if (cursor) cursor.style.opacity = '0'; 
          document.body.style.cursor = 'auto'; 
          return; 
        }
        
        const target = e.target instanceof Element ? e.target : null;
        const isNav = Boolean(target?.closest('#jd-bottom-nav, #jd-index-panel, #jd-thumbs-close, #jd-thumbs-header'));
        const nearBottom = e.clientY > window.innerHeight - 100;
        
        if (isNav || nearBottom) { 
          if (cursor) cursor.style.opacity = '0'; 
          document.body.style.cursor = 'auto'; 
        } else {
          if (cursor) {
            cursor.style.left = e.clientX + 'px';
            cursor.style.top = e.clientY + 'px';
            cursor.style.opacity = '1';
          }
          document.body.style.cursor = 'none';
          if (cursorArrow) cursorArrow.textContent = e.clientX > window.innerWidth / 2 ? '→' : '←';
        }
      });
      
      listen(document, 'mouseleave', () => { if (cursor) cursor.style.opacity = '0'; });
    }

    const indexBtnBottom = document.getElementById('jd-index-btn-bottom');
    const thumbsBtn = document.getElementById('jd-thumbs-btn');
    const counterEl = document.getElementById('jd-counter');

    /* Thumbs view */
    function openThumbsView() {
      cancelWheelMotion();
      mobileTouch = null;
      if (thumbsOpen) return;
      
      thumbsOpen = true;
      thumbsBtn?.setAttribute('aria-expanded', 'true');
      document.body.classList.add('thumbs-is-open');
      if (cursor) cursor.style.display = 'none';
      document.body.style.cursor = 'auto';
      thumbsPanel.classList.add('is-open');
      document.getElementById('jd-normal-nav').style.display = 'none';
      
      const thumbsNav = document.getElementById('jd-thumbs-nav');
      thumbsNav.style.animation = 'none';
      void thumbsNav.offsetWidth;
      thumbsNav.classList.add('is-open');
      thumbsNav.style.animation = '';
      
      if (typeof window.closeIndexPanel === 'function') window.closeIndexPanel();
      const currentCatSection = document.getElementById(`jd-thumbs-section-${categorySlug}`);
      if (currentCatSection) {
        const selected = window.innerWidth <= 800 ? mobileNavigationIndex() : current;
        const currentThumb = currentCatSection.querySelectorAll('.jd-thumb-global')[selected];
        if (currentThumb) { document.querySelectorAll('.jd-thumb-global.is-active').forEach(el => el.classList.remove('is-active')); currentThumb.classList.add('is-active'); }
        currentCatSection.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
      const hintArrows = document.getElementById('jd-hint-arrows');
      if (hintArrows) hintArrows.style.opacity = '0';
      const thumbsHeader = document.getElementById('jd-thumbs-header');
      if (thumbsHeader) thumbsHeader.setAttribute('aria-hidden', 'false');
    }
    
    function closeThumbsView() {
      if (!thumbsOpen) return;
      
      thumbsOpen = false;
      thumbsBtn?.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('thumbs-is-open');
      if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
        if (cursor) cursor.style.display = '';
        document.body.style.cursor = 'none';
      }
      thumbsPanel.classList.remove('is-open');
      document.getElementById('jd-normal-nav').style.display = 'flex';
      document.getElementById('jd-thumbs-nav').classList.remove('is-open');
      
      const hintArrows = document.getElementById('jd-hint-arrows');
      if (hintArrows) hintArrows.style.opacity = '1';
      const thumbsHeader = document.getElementById('jd-thumbs-header');
      if (thumbsHeader) thumbsHeader.setAttribute('aria-hidden', 'true');
    }
    thumbsBtn?.addEventListener('click', openThumbsView);
    document.getElementById('jd-thumbs-close')?.addEventListener('click', closeThumbsView);
    document.getElementById('jd-thumbs-close-btn')?.addEventListener('click', closeThumbsView);

    /* Index button */
    indexBtnBottom?.addEventListener('click', e => {
      e.stopPropagation();
      if (typeof window.openIndexPanel === 'function') {
        const panel = document.getElementById('jd-index-panel');
        panel?.classList.contains('is-open') ? window.closeIndexPanel() : window.openIndexPanel();
      }
    });

    /* Mobile counter click/tap to open menu */
    counterEl?.addEventListener('click', e => {
      e.stopPropagation();
      if (typeof window.openIndexPanel === 'function') {
        const panel = document.getElementById('jd-index-panel');
        panel?.classList.contains('is-open') ? window.closeIndexPanel() : window.openIndexPanel();
      }
    });
    counterEl?.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (typeof window.openIndexPanel === 'function') window.openIndexPanel();
      } else if (e.key === ' ') {
        e.preventDefault();
      }
    });
    counterEl?.addEventListener('keyup', e => {
      if (e.key === ' ' && typeof window.openIndexPanel === 'function') window.openIndexPanel();
    });

    /* Page entrance animation */
    async function startPageOpen() {
      const categoryArrival = document.documentElement.classList.contains('jd-category-arrival');
      const firstImage = slides[current]?.querySelector('img');
      if (categoryArrival) {
        await new Promise(resolve => requestAnimationFrame(resolve));
        let imageWait;
        const imageReady = firstImage && !firstImage.complete
          ? Promise.race([
              firstImage.decode().catch(() => {}),
              new Promise(resolve => { imageWait = setTimeout(resolve, 450); })
            ])
          : Promise.resolve();
        await Promise.allSettled([
          imageReady,
          new Promise(resolve => { setTimeout(resolve, 280); })
        ]);
        clearTimeout(imageWait);
        if (signal.aborted) return;
      }
      const revealDelay = reducedMotion.matches ? 0 : curtainRevealMs;
      if (window.innerWidth > 800) {
        const lastX = getSession('jdLastMouseX');
        const lastY = getSession('jdLastMouseY');
        if (lastX && lastY && cursor) {
          cursor.style.left = lastX + 'px';
          cursor.style.top = lastY + 'px';
          cursor.style.opacity = '0';
          document.body.style.cursor = 'none';
          window.jdCursorFrozen = true;
          setTimeout(() => {
            if (signal.aborted) return;
            window.jdCursorFrozen = false;
            cursor.style.opacity = '1';
          }, revealDelay);
        }
      } else {
        const catSpan = document.getElementById('jd-counter-cat');
        const counterRest = document.getElementById('jd-counter-rest');
        if (catSpan && counterRest) {
          setTimeout(() => {
            if (signal.aborted) return;
            catSpan.style.transition = 'opacity 0.6s ease';
            counterRest.style.transition = 'opacity 0.6s ease';
            catSpan.style.opacity = '1';
            counterRest.style.opacity = '1';
          }, revealDelay);
        }
      }
      setTimeout(() => {
        if (signal.aborted) return;
        if (categoryArrival) {
          document.documentElement.classList.add('jd-category-revealing');
          setTimeout(() => {
            if (signal.aborted) return;
            document.documentElement.classList.remove('jd-category-arrival');
            window.jdSyncBrowserTheme();
          }, revealDelay);
          setTimeout(() => {
            if (!signal.aborted) document.documentElement.classList.remove('jd-category-revealing');
          }, 1100);
        }
        document.body.classList.add('is-entering-ready');
        if (!getSession('jd-hints-seen')) {
          const hintArrows = document.getElementById('jd-hint-arrows');
          if (hintArrows) hintArrows.classList.add('show-hints');
          setSession('jd-hints-seen', 'true');
        }
      }, 50);
    }

    let hasOpened = false;
    function tryOpen() {
      if (!hasOpened) {
        hasOpened = true;
        startPageOpen();
      }
    }

    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      setTimeout(tryOpen, 100);
    } else {
      listen(document, 'DOMContentLoaded', () => setTimeout(tryOpen, 100));
    }
    listen(window, 'load', tryOpen);
    setTimeout(tryOpen, 1000);

    /* Index panel open/close (global) */
    const indexPanel = document.getElementById('jd-index-panel');
    const indexOverlay = document.getElementById('jd-index-overlay');
    const jdMain = document.getElementById('jd-main');

    // Index desktop hover preview logic (Dual Layer Smooth Crossfade)
    const imgA = document.getElementById('jd-index-preview-img-a');
    const imgB = document.getElementById('jd-index-preview-img-b');
    const indexLinks = document.querySelectorAll('.jd-index-link');
    const prefetchedUrls = window.__jdPrefetchedUrls || (window.__jdPrefetchedUrls = new Set());
    let currentLayer = 'a'; // 'a' or 'b'
    let activeSrc = '';
    let coverPreloaded = false;

    function setPreviewImage(src) {
      if (!imgA || !imgB || !src || src === activeSrc) return;
      activeSrc = src;

      const nextImg = currentLayer === 'a' ? imgB : imgA;
      const currentImg = currentLayer === 'a' ? imgA : imgB;

      nextImg.src = src;
      requestAnimationFrame(() => {
        nextImg.classList.add('is-active');
        currentImg.classList.remove('is-active');
        currentLayer = currentLayer === 'a' ? 'b' : 'a';
      });
    }

    function preloadCoverImages() {
      if (coverPreloaded || window.innerWidth <= 768) return;
      coverPreloaded = true;
      indexLinks.forEach(link => {
        const src = link.getAttribute('data-preview-src');
        if (src) {
          const preloader = new Image();
          preloader.decoding = 'async';
          preloader.src = src;
        }
      });
    }

    if (imgA && imgB && indexLinks.length > 0) {
      // Ennakkolataus: fetch() toimii kaikissa selaimissa, myös Safarissa
      // (link rel="prefetch" ei tue Safari – käytetään fetch()-pohjaista ratkaisua)
      function prefetchPage(url) {
        if (!url || url.startsWith('#') || prefetchedUrls.has(url)) return;
        prefetchedUrls.add(url);
        fetch(url, { priority: 'low' }).catch(() => { prefetchedUrls.delete(url); });
      }

      indexLinks.forEach(link => {
        link.addEventListener('mouseenter', () => {
          if (window.innerWidth <= 768) return;
          if (previewHideTimeout) { clearTimeout(previewHideTimeout); previewHideTimeout = null; }
          const targetSrc = link.getAttribute('data-preview-src');
          if (targetSrc && targetSrc !== activeSrc) {
            if (previewSwitchTimeout) clearTimeout(previewSwitchTimeout);
            previewSwitchTimeout = setTimeout(() => {
              setPreviewImage(targetSrc);
            }, 80);
          }
          // HTML-sivun ennakkolataus hover-hetkellä
          const href = link.getAttribute('href');
          if (href) prefetchPage(href);
        });

        // Mobiili: touchstart – sormi osuu linkkiin
        link.addEventListener('touchstart', () => {
          const href = link.getAttribute('href');
          if (href) prefetchPage(href);
        }, { passive: true });
      });

      indexPanel?.addEventListener('mouseleave', () => {
        previewHideTimeout = setTimeout(() => {
          imgA.classList.remove('is-active');
          imgB.classList.remove('is-active');
          activeSrc = '';
        }, 300);
      });
    }

    window.openIndexPanel = function() {
      cancelWheelMotion();
      mobileTouch = null;
      if (typeof closeThumbsView === 'function') closeThumbsView();
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.add('is-open'); }
      indexOverlay?.classList.add('is-open'); document.body.classList.add('index-is-open');
      indexBtnBottom?.setAttribute('aria-expanded', 'true');
      counterEl?.setAttribute('aria-expanded', 'true');
      if (cursor) cursor.style.display = 'none';
      document.body.style.cursor = 'auto';
      if (indexPanel) indexPanel.scrollTop = 0;

      // Autoselect active category preview and warm desktop covers only when menu opens.
      if (window.innerWidth > 768 && imgA) {
        const activeLink = document.querySelector('.jd-index-link.active');
        const activeCover = activeLink?.getAttribute('data-preview-src');
        if (activeCover) setPreviewImage(activeCover);
        preloadCoverImages();
      }
    };
    window.closeIndexPanel = function() {
      clearTimeout(previewSwitchTimeout);
      clearTimeout(previewHideTimeout);
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.remove('parallax-ready'); indexPanel.classList.remove('is-open'); }
      indexOverlay?.classList.remove('is-open'); document.body.classList.remove('index-is-open');
      indexBtnBottom?.setAttribute('aria-expanded', 'false');
      counterEl?.setAttribute('aria-expanded', 'false');
      if (imgA) imgA.classList.remove('is-active');
      if (imgB) imgB.classList.remove('is-active');
      activeSrc = '';
      if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
        if (cursor) cursor.style.display = '';
        document.body.style.cursor = 'none';
      }
    };

    window.openAboutPanel = function() {
      cancelWheelMotion();
      mobileTouch = null;
      const p = document.getElementById('jd-about-panel'); 
      if (p) { 
        p.classList.add('is-open'); 
        document.body.classList.add('about-is-open'); 
        if (cursor) cursor.style.opacity = '0';
        document.body.style.cursor = 'auto';
        const n = document.getElementById('jd-normal-nav'); 
        if (n) n.style.display = 'none'; 
      } 
    };
    window.closeAboutPanel = function() { 
      const p = document.getElementById('jd-about-panel'); 
      if (p) { 
        p.classList.remove('is-open'); 
        document.body.classList.remove('about-is-open'); 
        const n = document.getElementById('jd-normal-nav'); 
        const tp = document.getElementById('jd-thumbs-panel'); 
        if (n && (!tp || !tp.classList.contains('is-open'))) n.style.display = 'flex'; 
        if ('ontouchstart' in window === false && !window.matchMedia('(pointer: coarse)').matches) {
          if (cursor && !document.body.classList.contains('index-is-open') && !thumbsOpen) {
            document.body.style.cursor = 'none';
          }
        }
      } 
    };

    if (window.location.hash === '#jd-about-panel') window.openAboutPanel();

    indexOverlay?.addEventListener('click', () => window.closeIndexPanel());
    jdMain?.addEventListener('click', e => { if (e.target.closest('#jd-bottom-nav')) return; if (document.body.classList.contains('index-is-open')) window.closeIndexPanel(); });
    document.querySelectorAll('#jd-index-panel .jd-index-link.active').forEach(link => { link.addEventListener('click', e => { e.preventDefault(); window.closeIndexPanel(); }); });
    listen(document, 'keydown', e => { if (e.key === 'Escape') { window.closeIndexPanel(); window.closeAboutPanel(); closeThumbsView(); } });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeGallery, { once: true });
  } else {
    initializeGallery();
  }
  })();
  </script>

  {import.meta.env.DEV && <CreativeToolbar categorySlug={categorySlug} lang={lang} />}
</body>
</html>
