---
import t from '../data/t.yml';
import recent from '../data/recent.yml';
import work1 from '../data/work1.yml';
import work2 from '../data/work2.yml';
import work3 from '../data/work3.yml';
import tapahtumat from '../data/tapahtumat.yml';
import variJaMuoto from '../data/vari-ja-muoto.yml';
import raw from '../data/raw.yml';
import mustavalkoinenSarja from '../data/mustavalkoinen-sarja.yml';
import sisatilanValo from '../data/sisatilan-valo.yml';
import kiehtovatRakennukset from '../data/kiehtovat-rakennukset.yml';
import luontoJaYmparisto from '../data/luonto-ja-ymparisto.yml';
import stillLife from '../data/still-life.yml';
import elaimet from '../data/elaimet.yml';
import masters from '../data/masters-2026.yml';
import v365 from '../data/kuvaprojekti_ajasta_v365.yml';

const {
  lang = 'fi',
  dataset = [],
  categoryTitle = '',
  categorySlug = '',
  activeNav = '',
  translationUrl = '',
  nextUrl = '',
  prevUrl = '',
  title,
  description,
} = Astro.props;

const siteUrl = 'https://aatualatalo.com';
const pageTitle = title || (categoryTitle ? `${categoryTitle} — Aatu Alatalo` : 'Aatu Alatalo | Valokuvaaja');
const mainDesc = description || (lang === 'fi'
  ? 'Aatu Alatalo (s. 25. tammikuuta 2005, Tyrnävä) on Oulussa asuva valokuvaaja ja Hasselblad Masters 2026 -finalisti.'
  : 'Aatu Alatalo is a photographer from Tyrnävä, based in Oulu, Finland, and a Hasselblad Masters 2026 finalist.');

// Build gallery data JSON from dataset
const allCats = [
  { key: 'recent', data: recent },
  { key: 'work1', data: work1 },
  { key: 'work2', data: work2 },
  { key: 'work3', data: work3 },
  { key: 'tapahtumat', data: tapahtumat },
  { key: 'vari-ja-muoto', data: variJaMuoto },
  { key: 'raw', data: raw },
  { key: 'mustavalkoinen-sarja', data: mustavalkoinenSarja },
  { key: 'sisatilan-valo', data: sisatilanValo },
  { key: 'kiehtovat-rakennukset', data: kiehtovatRakennukset },
  { key: 'luonto-ja-ymparisto', data: luontoJaYmparisto },
  { key: 'still-life', data: stillLife },
  { key: 'elaimet', data: elaimet },
  { key: 'masters-2026', data: masters },
  { key: 'kuvaprojekti-ajasta-v365', data: v365 },
];

function resolveImagePaths(kuva: string) {
  const fn = kuva.split('/').pop()!.split('.')[0];
  const mob = `${fn}_mobile.webp`;
  const dsk = `${fn}_desktop.webp`;
  if (kuva.includes('http')) {
    const fnext = kuva.split('/').pop()!;
    const bpath = kuva.replace(fnext, '');
    return { src: `${bpath}thumbs/${dsk}`, srcMob: `${bpath}thumbs/${mob}`, full: kuva };
  }
  return { src: `/assets/thumbnails/${dsk}`, srcMob: `/assets/thumbnails/${mob}`, full: `/assets/images/${kuva}` };
}

let jdIdx = 0;
const galleryData: any[] = [];
for (const item of dataset) {
  if (item.tyyppi === 'teksti') continue;
  if (item.layout === 'diptych' && item.images) {
    const images = item.images.map((sub: any) => {
      const { src, srcMob, full } = resolveImagePaths(sub.kuva);
      return { src, srcset: `${srcMob} 800w, ${src} 1600w, ${full} 3000w`, full, thumb: srcMob, alt: sub.alt_text || '' };
    });
    const titleVal = item.otsikko || '';
    galleryData.push({
      i: jdIdx++, layout: 'diptych', images,
      title: lang === 'fi' ? titleVal.split(' / ').pop()?.trim() : titleVal.split(' / ')[0]?.trim(),
      place: item.paikka || '', series: item.series || 'all',
    });
  } else {
    const { src, srcMob, full } = resolveImagePaths(item.kuva);
    const titleVal = item.otsikko || '';
    galleryData.push({
      i: jdIdx++, src, srcset: `${srcMob} 800w, ${src} 1600w, ${full} 3000w`, full, thumb: srcMob,
      alt: item.alt_text || '',
      title: lang === 'fi' ? titleVal.split(' / ').pop()?.trim() : titleVal.split(' / ')[0]?.trim(),
      place: item.paikka || '', series: item.series || 'all',
    });
  }
}

// Build category label map
const catLabels: Record<string, string> = {
  recent: lang === 'fi' ? 'Uusimmat' : 'Recent',
  work1: lang === 'fi' ? 'Työ I' : 'Work I',
  work2: lang === 'fi' ? 'Työ II' : 'Work II',
  work3: lang === 'fi' ? 'Työ III' : 'Work III',
  'masters-2026': 'Hasselblad Masters 2026',
  'kuvaprojekti-ajasta-v365': t.v365[lang],
  'tapahtumat': t.events[lang],
  'vari-ja-muoto': t.color_and_form[lang],
  raw: t.portraits[lang],
  'mustavalkoinen-sarja': t.monochrome[lang],
  'sisatilan-valo': t.interior[lang],
  'kiehtovat-rakennukset': t.buildings[lang],
  'luonto-ja-ymparisto': t.nature[lang],
  'still-life': t.still_life[lang],
  elaimet: t.animals[lang],
};

const catLabel = categoryTitle || catLabels[categorySlug] || categorySlug;
const isEventsCategory = categorySlug === 'tapahtumat';

// Index panel data
const indexCounts: Record<string, number> = {};
allCats.forEach(c => { indexCounts[c.key] = c.data?.length || 0; });

const fiBase = (slug: string) => `/${slug}`;
const enBase = (slug: string, enSlug?: string) => `/en/${enSlug || slug}`;

const getCatUrl = (key: string, l: string) => {
  return l === 'en'
    ? `/en/${key === 'kuvaprojekti-ajasta-v365' ? 'photo-project-time-v365' : key === 'tapahtumat' ? 'events' : key === 'vari-ja-muoto' ? 'color-and-form' : key === 'mustavalkoinen-sarja' ? 'black-and-white-series' : key === 'sisatilan-valo' ? 'interior-light' : key === 'kiehtovat-rakennukset' ? 'buildings' : key === 'luonto-ja-ymparisto' ? 'nature' : key}`
    : `/${key}`;
};

const currentIndex = allCats.findIndex(c => c.key === categorySlug);
let computedNextUrl = nextUrl;
let computedPrevUrl = prevUrl;

if (currentIndex !== -1) {
  if (!computedNextUrl && currentIndex < allCats.length - 1) {
    computedNextUrl = getCatUrl(allCats[currentIndex + 1].key, lang);
  }
  if (!computedPrevUrl && currentIndex > 0) {
    computedPrevUrl = getCatUrl(allCats[currentIndex - 1].key, lang);
  }
}

const navItems = [
  { fi: 'recent', en: 'recent', label: lang === 'fi' ? 'Uusimmat' : 'Recent' },
  { fi: 'work1', en: 'work1', label: lang === 'fi' ? 'Työ I' : 'Work I' },
  { fi: 'work2', en: 'work2', label: lang === 'fi' ? 'Työ II' : 'Work II' },
  { fi: 'work3', en: 'work3', label: lang === 'fi' ? 'Työ III' : 'Work III' },
];
const catNavItems = [
  { fi: 'tapahtumat', en: 'events', label: t.events[lang] },
  { fi: 'vari-ja-muoto', en: 'color-and-form', label: t.color_and_form[lang] },
  { fi: 'raw', en: 'raw', label: t.portraits[lang] },
  { fi: 'mustavalkoinen-sarja', en: 'black-and-white-series', label: t.monochrome[lang] },
  { fi: 'sisatilan-valo', en: 'interior-light', label: t.interior[lang] },
  { fi: 'kiehtovat-rakennukset', en: 'buildings', label: t.buildings[lang] },
  { fi: 'luonto-ja-ymparisto', en: 'nature', label: t.nature[lang] },
  { fi: 'still-life', en: 'still-life', label: t.still_life[lang] },
  { fi: 'elaimet', en: 'animals', label: t.animals[lang] },
];
const projectNavItems = [
  { fi: 'masters-2026', en: 'masters-2026', label: 'Hasselblad Masters 2026' },
  { fi: 'kuvaprojekti-ajasta-v365', en: 'photo-project-time-v365', label: t.v365[lang] },
];

function navUrl(item: { fi: string; en: string }) {
  return lang === 'en' ? `/en/${item.en}` : `/${item.fi}`;
}
function isActive(item: { fi: string }) {
  return activeNav === item.fi;
}

const currentUrl = Astro.url.pathname;
const fiTransUrl = translationUrl || (lang === 'en' ? currentUrl.replace(/^\/en\//, '/') : currentUrl);
const enTransUrl = translationUrl || (lang === 'fi' ? `/en${currentUrl}` : currentUrl);
const switchLangUrl = lang === 'fi' ? enTransUrl : fiTransUrl;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#f5f4f0">
  <title>{pageTitle}</title>
  <meta name="description" content={mainDesc}>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/images/favicon-192x192.png">
  <link rel="apple-touch-icon" href="/assets/images/favicon-192x192.png">
  <meta property="og:title" content={pageTitle}>
  <meta property="og:description" content={mainDesc}>
  <meta property="og:type" content="website">
  <meta property="og:image" content={`${siteUrl}/assets/images/PROJECT%2021%20FINALIST.jpg`}>
  <link rel="canonical" href={`${siteUrl}${currentUrl}`}>
  {translationUrl && <link rel="alternate" hreflang="fi" href={`${siteUrl}${fiTransUrl}`} />}
  {translationUrl && <link rel="alternate" hreflang="en" href={`${siteUrl}${enTransUrl}`} />}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preconnect" href="https://media.aatualatalo.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lora:ital@0;1&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lora:ital@0;1&display=swap" media="print" onload="this.media='all'">
  <style is:global>
    /* ─── RESET ────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --jd-bg:       #f5f4f0;
      --jd-text:     #1a1a18;
      --jd-dimmed:   #888880;
      --jd-font:     'Helvetica Neue', Helvetica, Arial, sans-serif;
      --jd-font-serif: 'Lora', Georgia, serif;
      --jd-panel-w:  50vw;
    }

    html, body {
      width: 100%; height: 100%;
      overflow: hidden;
      touch-action: pan-y;
      background: var(--jd-bg);
      color: var(--jd-text);
      font-family: var(--jd-font);
    }

    /* Subtle film-grain texture */
    body::before {
      content: "";
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 999999;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      opacity: 0.03;
    }

    a { color: inherit; text-decoration: none; }
    img { -webkit-user-drag: none; user-select: none; -webkit-user-select: none; }

    /* ─── HEADER ──────────────────────────────────────── */
    #jd-header {
      position: fixed; top: 0; left: 0; right: 0;
      z-index: 200;
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 1.4rem 1.8rem;
      pointer-events: none;
    }
    .jd-header-left, .jd-header-right {
      pointer-events: auto;
      display: flex; flex-direction: column; gap: 0.4rem;
    }
    .jd-ui-btn {
      background: none; border: none;
      color: var(--jd-text);
      font-family: var(--jd-font);
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      cursor: pointer; padding: 0; opacity: 1;
    }
    .jd-ui-link {
      color: var(--jd-text); text-decoration: none;
      font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
    }

    /* Tactile press feedback */
    .jd-ui-btn, .jd-ui-link, .jd-bottom-btn, .jd-index-link {
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease !important;
      will-change: transform, opacity;
    }
    .jd-bottom-btn, .jd-ui-btn, .jd-ui-link { display: inline-block; transform-origin: center; }
    .jd-index-link { transform-origin: left center; }
    .jd-ui-btn:active, .jd-ui-link:active, .jd-bottom-btn:active, .jd-index-link:active {
      transform: scale(0.985) !important; opacity: 0.6 !important;
      transition: transform 0.05s ease, opacity 0.05s ease !important;
    }

    /* ─── MAIN ───────────────────────────────────────── */
    #jd-main {
      position: absolute !important;
      inset: 0 !important;
    }

    /* ─── SLIDESHOW ─────────────────────────────────── */
    #jd-slideshow {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      user-select: none; -webkit-user-select: none;
    }
    .jd-slide {
      position: absolute; inset: 0;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; transition: opacity 0.8s ease; pointer-events: none;
    }
    .jd-slide.active { opacity: 1; pointer-events: auto; }
    .jd-slide img {
      max-width: calc(100% - 120px);
      max-height: calc(100vh - 180px); max-height: calc(100dvh - 180px);
      width: auto; height: auto; object-fit: contain; display: block;
    }
    .jd-diptych-slide { flex-direction: row; gap: 30px; width: 100vw; }
    .jd-diptych-slide img { max-width: calc(50% - 75px) !important; }

    /* ─── BOTTOM NAV ─────────────────────────────────── */
    #jd-bottom-nav {
      position: fixed; bottom: 25px; left: 0; right: 0;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 8px; z-index: 100000; pointer-events: none; cursor: auto;
    }
    .jd-bottom-btn {
      background: none; border: none;
      color: #1a1a18 !important; -webkit-text-fill-color: #1a1a18 !important;
      font-family: var(--jd-font);
      font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
      cursor: pointer !important; pointer-events: auto;
      opacity: 1 !important; padding: 0.5rem 1rem;
    }
    .jd-nav-divider {
      color: #1a1a18 !important; -webkit-text-fill-color: #1a1a18 !important;
      opacity: 1 !important; font-size: 0.8rem; padding: 0 0.2rem;
      pointer-events: none; user-select: none;
    }
    #jd-counter { display: none; }

    /* ─── SHUTTER / CURTAIN ─────────────────────────── */
    #jd-shutter-container {
      position: fixed; inset: 0; z-index: 99998; pointer-events: none;
    }
    .jd-curtain-primary {
      position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      z-index: 9999998; background: var(--jd-bg); transform: translateY(0);
      will-change: transform;
    }
    .jd-curtain-primary::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      opacity: 0.03;
    }
    .jd-shutter-title {
      position: fixed; top: 55%; left: 50%; transform: translate(-50%, -50%);
      color: white; mix-blend-mode: difference; z-index: 99999999;
      font-family: var(--jd-font); font-size: 1.4rem; letter-spacing: 0.22em; text-transform: uppercase;
      opacity: 0; pointer-events: none;
      transition: top 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
    }
    body.show-shutter-title .jd-shutter-title { top: 50%; opacity: 1; }
    body.is-entering-ready .jd-shutter-title { top: 40%; opacity: 0; transition: top 0.5s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease; }
    body.is-leaving .jd-shutter-title, body.prepare-leave .jd-shutter-title { opacity: 0 !important; transition: none !important; }
    body.is-entering-ready .jd-curtain-primary { transition: transform 1800ms 0ms cubic-bezier(0.76,0,0.24,1); transform: translateY(-150vh); }
    body.prepare-leave .jd-curtain-primary { transition: none; transform: translateY(-150vh); }
    body.is-leaving .jd-curtain-primary { transition: transform 1400ms 0ms cubic-bezier(0.76,0,0.24,1); transform: translateY(0); }

    /* ─── INDEX PANEL ────────────────────────────────── */
    #jd-index-panel {
      position: fixed !important; top: 100% !important; right: 0; left: auto;
      width: 50%; height: 100dvh !important;
      background: rgba(245, 244, 240, 0.82);
      -webkit-backdrop-filter: saturate(180%) blur(24px);
      backdrop-filter: saturate(180%) blur(24px);
      color: var(--jd-text);
      z-index: 500; padding: 4rem 2.5rem 2.5rem;
      overflow-y: auto; overscroll-behavior-y: contain; cursor: auto;
      transition: transform 0.6s cubic-bezier(0.16,1,0.3,1), opacity 0.4s ease;
      transform: translateY(0); opacity: 0;
    }
    @supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
      #jd-index-panel { background: var(--jd-bg); }
    }
    #jd-index-panel.is-open { transform: translateY(-100%); opacity: 1; }
    #jd-index-panel a, #jd-index-panel div, #jd-index-panel span { color: var(--jd-text) !important; }

    #jd-index-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      z-index: 490; background: rgba(0,0,0,0); opacity: 0; pointer-events: none;
      transition: background 0.8s cubic-bezier(0.16,1,0.3,1), opacity 0.01s;
    }
    #jd-index-overlay.is-open {
      background: rgba(0,0,0,0); opacity: 1; pointer-events: auto; cursor: pointer;
      width: calc(100vw - var(--jd-panel-w));
    }

    /* Index panel inner styles */
    .jd-top-nav {
      display: flex; flex-wrap: wrap; gap: 1.2rem; margin-bottom: 4rem;
      font-family: var(--jd-font); font-size: 1rem;
    }
    .jd-index-link {
      display: flex; justify-content: space-between; align-items: baseline;
      font-family: var(--jd-font); font-size: 0.95rem; letter-spacing: 0.04em;
      padding: 0.15rem 0;
    }
    .jd-count { font-size: 0.9em; font-family: var(--jd-font-serif); font-style: italic; }
    .jd-index-link.active span:first-child { font-style: italic; }
    .jd-mobile-close { display: none; }

    /* ─── THUMBS PANEL ───────────────────────────────── */
    #jd-thumbs-panel {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: var(--jd-bg); z-index: 300; overflow-y: auto;
      padding: 4rem 1.5rem 2rem; opacity: 0; pointer-events: none;
      transition: opacity 0.25s;
    }
    #jd-thumbs-panel.is-open { opacity: 1; pointer-events: auto; }
    .jd-thumbs-inner { max-width: 1600px; margin: 0 auto; }
    .jd-thumbs-section { margin-bottom: 5rem; scroll-margin-top: 6rem; }
    .jd-thumbs-section-title {
      font-family: var(--jd-font); font-size: 1rem; letter-spacing: 0.15em;
      text-transform: uppercase; color: rgba(26,26,24,0.7);
      margin-bottom: 2rem; text-align: center;
    }
    .jd-thumbs-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; }
    .jd-thumb-global { cursor: pointer; position: relative; width: calc(25% - 2rem); }
    .jd-thumb-global img { width: 100%; height: auto; display: block; transition: opacity 0.15s ease-out; }
    .jd-thumb-global:hover img { opacity: 0.7; }
    .jd-thumb-global.is-active img { outline: 2px solid #1a1a18; outline-offset: 6px; }
    #jd-thumbs-nav { display: none; align-items: center; justify-content: center; gap: 0; }
    #jd-thumbs-nav.is-open { display: flex; }
    #jd-thumbs-panel.is-open ~ #jd-bottom-nav #jd-normal-nav { display: none; }

    /* ─── FILTER ─────────────────────────────────────── */
    .jd-filter-dropdown-container { position: fixed; bottom: 25px; right: 35px; display: none; pointer-events: auto; z-index: 100000; }
    .jd-filter-dropdown-container.is-visible { display: block; }
    .jd-filter-menu {
      position: absolute; bottom: 100%; right: 0;
      display: flex; flex-direction: column; gap: 12px;
      background: #f5f4f0; padding: 15px 25px; border-radius: 4px;
      opacity: 0; pointer-events: none; transition: opacity 0.2s;
      z-index: 10000; box-shadow: 0 4px 15px rgba(0,0,0,0.06); margin-bottom: 15px;
    }
    .jd-filter-menu.is-open { opacity: 1; pointer-events: auto; }
    .jd-filter-btn {
      background: none; border: none; color: rgba(26,26,24,0.5);
      font-family: var(--jd-font); font-size: 0.68rem; letter-spacing: 0.22em;
      text-transform: uppercase; cursor: pointer; padding: 0; transition: color 0.3s; white-space: nowrap;
    }
    .jd-filter-btn:hover { color: rgba(26,26,24,0.8); }
    .jd-filter-btn.active { color: rgba(26,26,24,1); }

    /* ─── CUSTOM CURSOR ─────────────────────────────── */
    #jd-cursor-custom {
      position: fixed; pointer-events: none; z-index: 9999;
      transform: translate(-50%, -50%);
      font-family: var(--jd-font); font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase;
      color: white; mix-blend-mode: difference; white-space: nowrap;
      opacity: 0; transition: opacity 0.2s; user-select: none;
      display: flex; flex-direction: column; align-items: center; gap: 4px;
    }
    #jd-cursor-arrow { font-size: 14px; letter-spacing: 0; line-height: 1; margin-top: -2px; }

    /* ─── HINT ARROWS ───────────────────────────────── */
    #jd-hint-arrows {
      position: fixed; top: 50%; left: 0; right: 0; transform: translateY(-50%);
      display: none; justify-content: space-between; padding: 0 5vw;
      pointer-events: none; z-index: 10000; opacity: 1;
    }
    #jd-hint-arrows.show-hints { display: flex; animation: fadeHintOut 1.5s cubic-bezier(0.16,1,0.3,1) forwards; animation-delay: 10s; }
    .jd-hint-arrow {
      width: 65px; height: 65px; border-radius: 50%;
      background: rgba(245,244,240,0.4); backdrop-filter: blur(4px);
      display: flex; align-items: center; justify-content: center;
      color: rgba(26,26,24,0.6); animation: pulseArrow 2.5s infinite ease-in-out;
    }
    .jd-hint-arrow.left { animation-delay: 0s; }
    .jd-hint-arrow.right { animation-delay: 1.25s; }
    @keyframes fadeHintOut { to { opacity: 0; visibility: hidden; } }
    @keyframes pulseArrow { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1); background: rgba(245,244,240,0.6); color: rgba(26,26,24,0.9); } }
    @keyframes thumbFadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
    .jd-thumb.thumb-animate { opacity: 0; animation: thumbFadeIn 0.4s ease forwards; }

    /* ─── ABOUT PANEL ────────────────────────────────── */
    #jd-about-panel {
      position: fixed; inset: 0;
      background: rgba(245,244,240,0.98); z-index: 350;
      overflow-y: auto; opacity: 0; pointer-events: none;
      transition: opacity 0.6s cubic-bezier(0.16,1,0.3,1);
      display: flex; flex-direction: column;
    }
    #jd-about-panel.is-open { opacity: 1; pointer-events: auto; }
    .jd-about-content {
      display: flex; flex-direction: row; max-width: 1100px; margin: auto;
      padding: 6rem 3rem 8rem; gap: 5rem; align-items: center;
      transform: translateY(20px); transition: transform 0.8s cubic-bezier(0.16,1,0.3,1), opacity 0.8s ease; opacity: 0;
    }
    #jd-about-panel.is-open .jd-about-content { transform: translateY(0); opacity: 1; transition-delay: 0.1s; }
    .jd-about-image { flex: 1; max-width: 450px; }
    .jd-about-image img { width: 100%; height: auto; display: block; }
    .jd-about-text { flex: 1.2; color: #1a1a1a; font-family: var(--jd-font); }
    .jd-about-text header { margin-bottom: 2.5rem; }
    .jd-about-text h1 { font-family: var(--jd-font-serif); font-size: 2.5rem; font-weight: 400; margin: 0 0 0.5rem 0; letter-spacing: 0.02em; }
    .jd-about-subtitle { font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.5; }
    .jd-about-bio { font-size: 1.1rem; line-height: 1.6; margin-bottom: 3rem; max-width: 500px; }
    .jd-about-section { margin-bottom: 2rem; }
    .jd-about-section h2 { font-size: 0.75rem; letter-spacing: 0.15em; text-transform: uppercase; opacity: 0.5; margin-bottom: 1rem; }
    .jd-about-section ul { list-style: none; padding: 0; margin: 0; }
    .jd-about-section li { font-size: 0.95rem; line-height: 1.5; margin-bottom: 0.8rem; max-width: 500px; }
    #jd-about-bottom-nav {
      position: fixed; bottom: 25px; left: 0; right: 0; height: 56px;
      display: flex; align-items: center; justify-content: center; pointer-events: none; z-index: 410;
    }
    .jd-about-nav-container { display: flex; align-items: center; gap: 0; pointer-events: none; }
    #jd-about-panel .jd-bottom-btn { pointer-events: none; }
    #jd-about-panel.is-open .jd-about-nav-container, #jd-about-panel.is-open .jd-bottom-btn { pointer-events: auto; }

    /* ─── MOBILE ─────────────────────────────────────── */
    @media (max-width: 768px) {
      :root { --jd-panel-w: 100%; }
      #jd-index-panel { width: 100%; left: 0; right: 0; }
      #jd-header { padding: 1rem 1.2rem; }
      #jd-index-overlay.is-open { width: 100%; }
      .jd-mobile-close { display: inline; text-decoration: underline; }
    }
    @media (max-width: 800px) {
      html { background: #000 !important; }
      html, body { position: fixed !important; height: 100dvh !important; overscroll-behavior: none !important; min-height: 0 !important; }
      #jd-main, #jd-slideshow { position: fixed !important; }
      body.is-entering-ready .jd-curtain-primary { transform: translateY(100%); }
      body.index-is-open #jd-counter, body.index-is-open #jd-bottom-nav { opacity: 0 !important; visibility: hidden !important; transition: opacity 0.3s ease; }
      .jd-slide img { width: 100%; height: 100%; max-width: calc(100% - 28px); max-height: 100%; object-fit: contain; }
      .jd-diptych-slide { flex-direction: column; gap: 15px; }
      .jd-diptych-slide img { max-width: calc(100% - 28px) !important; max-height: calc(50dvh - 75px) !important; }
      #jd-bottom-nav { bottom: auto; top: 0; height: auto; min-height: 70px; background: #f5f4f0; width: 100%; padding-top: 25px; padding-bottom: 15px; }
      .jd-filter-dropdown-container { bottom: auto; top: 25px; right: 25px; }
      .jd-filter-menu { bottom: auto; top: 100%; margin-bottom: 0; margin-top: 15px; }
      #jd-hint-arrows { top: auto; bottom: 25px; transform: none; padding: 0 20px; }
      .jd-hint-arrow { background: none; backdrop-filter: none; width: auto; height: auto; color: rgba(26,26,24,0.4); }
      .jd-hint-arrow svg { width: 22px; height: 22px; }
      #jd-slideshow { top: 90px; bottom: 60px; height: calc(100dvh - 150px); }
      #jd-counter { display: block; position: fixed; bottom: 25px; left: 0; right: 0; text-align: center; color: #1a1a18 !important; font-family: var(--jd-font); font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase; z-index: 100000; pointer-events: none; }
      #jd-cursor-custom { display: none !important; }

      .jd-thumb-global { width: calc(50% - 1rem); }
      .jd-thumbs-grid { gap: 1rem; }
      #jd-about-bottom-nav { bottom: auto; top: 0; height: 70px; background: #f5f4f0; width: 100%; }
      .jd-about-content { flex-direction: column; padding-top: 5rem; gap: 2.5rem; }
      .jd-about-text h1 { font-size: 2.2rem; }
    }
  </style>
</head>
<body ontouchstart="">

  <!-- Main slideshow area -->
  <main id="jd-main">
    <div id="jd-slideshow"></div>
  </main>

  <!-- Gallery data for JS -->
  <script id="jd-data" type="application/json" set:html={JSON.stringify(galleryData)}></script>
  <script id="jd-meta" type="application/json" set:html={JSON.stringify({ catLabel, categorySlug, isEventsCategory, lang })}></script>

  <!-- Hint arrows -->
  <div id="jd-hint-arrows">
    <div class="jd-hint-arrow left">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 18l-6-6 6-6"/></svg>
    </div>
    <div class="jd-hint-arrow right">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 18l6-6-6-6"/></svg>
    </div>
  </div>

  <!-- Bottom nav -->
  <div id="jd-bottom-nav">
    <div id="jd-normal-nav" style="display:flex;align-items:center;gap:0;pointer-events:auto;">
      <button class="jd-bottom-btn" id="jd-index-btn-bottom">{lang === 'en' ? 'Index' : 'Valikko'}</button>
      <span class="jd-nav-divider">—</span>
      <button class="jd-bottom-btn" id="jd-thumbs-btn">{lang === 'en' ? 'All Works' : 'Kaikki teokset'}</button>
    </div>
    <div id="jd-filter-dropdown-container" class="jd-filter-dropdown-container">
      <button id="jd-filter-toggle" class="jd-bottom-btn" aria-label="Filter" style="display:flex;align-items:center;justify-content:center;height:100%;cursor:pointer;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="rgba(26,26,24,0.35)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
      </button>
      <div id="jd-filter-menu" class="jd-filter-menu"></div>
    </div>
    <div id="jd-thumbs-nav">
      <span class="jd-bottom-btn" style="cursor:default;">{catLabel}</span>
      <span class="jd-nav-divider">—</span>
      <button class="jd-bottom-btn" id="jd-thumbs-close">{lang === 'en' ? 'Close' : 'Sulje'}</button>
    </div>
  </div>

  <!-- Mobile counter -->
  <div id="jd-counter">{catLabel} — <span id="jd-counter-num">1</span> / <span id="jd-counter-tot">{galleryData.length}</span></div>




  <!-- Custom cursor -->
  <div id="jd-cursor-custom">
    <div id="jd-cursor-text">{catLabel} — 1 / {galleryData.length}</div>
    <div id="jd-cursor-arrow"></div>
  </div>

  <!-- Next/prev urls for gallery-to-gallery navigation -->
  {computedNextUrl && <div id="jd-next-url" style="display:none">{computedNextUrl}</div>}
  {computedPrevUrl && <div id="jd-prev-url" style="display:none">{computedPrevUrl}</div>}

  <!-- Index panel -->
  <nav id="jd-index-panel">
    <div class="jd-top-nav">
      <a href={lang === 'en' ? '/en/recent' : '/recent'} style="text-decoration: underline; text-underline-offset: 4px;">
        {lang === 'en' ? 'Works' : 'Kategoriat'}
      </a>
      <a href="#" onclick="window.closeIndexPanel(); window.openAboutPanel(); return false;">
        {lang === 'en' ? 'Info' : 'Info & Ajatuksia'}
      </a>
      <a href="https://www.instagram.com/teeaatu/" target="_blank" rel="noopener">Instagram</a>
      <div style="margin-left:auto;display:flex;gap:1.5rem;align-items:baseline;">
        <a href={switchLangUrl} onclick={`localStorage.setItem('langPref','${lang === 'fi' ? 'en' : 'fi'}')`}>
          {lang === 'fi' ? 'EN' : 'FI'}
        </a>
        <a href="#" class="jd-mobile-close" onclick="window.closeIndexPanel(); return false;">
          {lang === 'fi' ? 'Sulje' : 'Close'}
        </a>
      </div>
    </div>

    <ul style="list-style:none;margin-bottom:3rem;">
      {navItems.map(item => (
        <li style="margin-bottom:0.6rem;">
          <a href={navUrl(item)} class={`jd-index-link ${isActive(item) ? 'active' : ''}`}>
            <span>{item.label}</span>
            <span class="jd-count">{indexCounts[item.fi]}</span>
          </a>
        </li>
      ))}
    </ul>

    <ul style="list-style:none;margin-bottom:3rem;">
      {catNavItems.map(item => (
        <li style="margin-bottom:0.6rem;">
          <a href={navUrl(item)} class={`jd-index-link ${isActive(item) ? 'active' : ''}`}>
            <span>{item.label}</span>
            <span class="jd-count">{indexCounts[item.fi]}</span>
          </a>
        </li>
      ))}
    </ul>

    <ul style="list-style:none;margin-bottom:3rem;">
      {projectNavItems.map(item => (
        <li style="margin-bottom:0.6rem;">
          <a href={navUrl(item)} class={`jd-index-link ${isActive(item) ? 'active' : ''}`}>
            <span>{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div id="jd-index-overlay"></div>

  <!-- About panel -->
  <div id="jd-about-panel">
    <div class="jd-about-content">
      <div class="jd-about-image">
        <picture>
          <source srcset="/assets/thumbnails/aatu-alatalo-valokuvaaja-oulu_mobile.webp 600w, /assets/thumbnails/aatu-alatalo-valokuvaaja-oulu_desktop.webp 1200w" type="image/webp" sizes="(max-width:768px) 100vw, 50vw">
          <img src="/assets/thumbnails/aatu-alatalo-valokuvaaja-oulu_desktop.webp" alt="Aatu Alatalo - Photographer" loading="lazy" width="1080" height="1440" draggable="false" oncontextmenu="return false;">
        </picture>
      </div>
      <div class="jd-about-text">
        <header>
          <h1>Aatu Alatalo</h1>
          <div class="jd-about-subtitle">Photographer Oulu & Hasselblad Masters Finalist</div>
        </header>
        <div class="jd-about-bio">
          {lang === 'en' ? (
            <p>I am a 21-year-old photographer from the Tyrnävä Lakeus region, currently based in Oulu. I study media at Oulu University of Applied Sciences. I started photography in 2014, and over the past decade, my camera has become an inseparable part of my everyday life.</p>
          ) : (
            <p>Olen 21-vuotias valokuvaaja, joka on varttunut Tyrnävän Lakeuden seudulla ja asuu nykyään Oulussa. Opiskelen tällä hetkellä medianomiksi Oulun ammattikorkeakoulussa. Aloitin valokuvauksen vuonna 2014, ja viimeisen vuosikymmenen aikana kamerasta on tullut erottamaton osa arkeani.</p>
          )}
        </div>
        <div class="jd-about-section">
          <h2>{lang === 'en' ? 'Awards and Recognitions' : 'Palkinnot ja tunnustukset'}</h2>
          <ul>
            <li><strong>Hasselblad Masters 2026</strong>: Finalist in Project//21 category.</li>
            <li><strong>SAKUstars 2023</strong>: Honorable mention in "Photographic Art in a Day".</li>
          </ul>
        </div>
        <div class="jd-about-section">
          <h2>{lang === 'en' ? 'Selected Projects' : 'Valikoidut projektit'}</h2>
          <ul>
            <li><strong>Outshine</strong>: Digital advertising project for Oulu bus stops 2025 and 2026.</li>
            <li>{lang === 'en' ? <><strong>Exhibitions</strong>: Exhibited at Piippolan Könkkölä and Kestilä Library 2023–2024.</> : <><strong>Näyttelyt</strong>: Teoksiani on ollut esillä Piippolan Könkkölässä sekä Kestilän kirjastossa vuosina 2023 ja 2024.</>}</li>
          </ul>
        </div>
      </div>
    </div>
    <div id="jd-about-bottom-nav">
      <div class="jd-about-nav-container">
        <span class="jd-bottom-btn" style="opacity:0.5;cursor:default;">{lang === 'en' ? 'Info & About' : 'Info & Ajatuksia'}</span>
        <span class="jd-nav-divider">—</span>
        <button class="jd-bottom-btn" onclick="window.closeAboutPanel()">{lang === 'en' ? 'Close' : 'Sulje'}</button>
      </div>
    </div>
  </div>

  <!-- Shutter curtain -->
  <div id="jd-shutter-container">
    <div class="jd-curtain-primary"></div>
  </div>
  <div class="jd-shutter-title">{catLabel}</div>

  <!-- Global thumbs panel (all categories) -->
  <div id="jd-thumbs-panel">
    <div class="jd-thumbs-inner">
      {allCats.map(({ key, data }) => {
        const catUrl = getCatUrl(key, lang);
        return data && data.length > 0 ? (
          <div class="jd-thumbs-section" id={`jd-thumbs-section-${key}`}>
            <div class="jd-thumbs-section-title">{catLabels[key] || key}</div>
            <div class="jd-thumbs-grid">
              {data.filter((item: any) => item.tyyppi !== 'teksti').map((item: any, idx: number) => {
                if (item.layout === 'diptych' && item.images) {
                  const sub = item.images[0];
                  if (!sub) return null;
                  const fn = sub.kuva.split('/').pop().split('.')[0];
                  const mob = `${fn}_mobile.webp`;
                  const srcMob = sub.kuva.includes('http')
                    ? `${sub.kuva.replace(sub.kuva.split('/').pop(), '')}thumbs/${mob}`
                    : `/assets/thumbnails/${mob}`;
                  return (
                    <div class="jd-thumb-global" data-cat={key} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                      <img src={srcMob} loading="lazy" alt={sub.alt_text || ''}>
                    </div>
                  );
                }
                const fn = item.kuva.split('/').pop().split('.')[0];
                const mob = `${fn}_mobile.webp`;
                const srcMob = item.kuva.includes('http')
                  ? `${item.kuva.replace(item.kuva.split('/').pop(), '')}thumbs/${mob}`
                  : `/assets/thumbnails/${mob}`;
                return (
                  <div class="jd-thumb-global" data-cat={key} data-idx={idx} data-url={`${catUrl}#img-${idx}`}>
                    <img src={srcMob} loading="lazy" alt={item.alt_text || ''}>
                  </div>
                );
              })}
            </div>
          </div>
        ) : null;
      })}
    </div>
  </div>

  <script is:inline>
  document.addEventListener('DOMContentLoaded', function () {
    const metaEl = document.getElementById('jd-meta');
    const meta = metaEl ? JSON.parse(metaEl.textContent) : {};
    const { catLabel, categorySlug, isEventsCategory } = meta;

    const data = JSON.parse(document.getElementById('jd-data').textContent);
    const total = data.length;

    const slideshow = document.getElementById('jd-slideshow');
    const thumbsPanel = document.getElementById('jd-thumbs-panel');
    const counterNum = document.getElementById('jd-counter-num');
    const cursor = document.getElementById('jd-cursor-custom');
    const shutter = document.querySelector('.jd-curtain-primary');
    const shutterTitle = document.querySelector('.jd-shutter-title');

    if (cursor && cursor.parentElement !== document.body) document.body.appendChild(cursor);

    const slides = [];
    let current = 0;
    let thumbsOpen = false;

    const hash = window.location.hash;
    if (hash && hash.startsWith('#img-')) {
      const idx = parseInt(hash.replace('#img-', ''), 10);
      if (!isNaN(idx) && idx >= 0 && idx < total) current = idx;
    }

    function createSlide(item, i) {
      const slide = document.createElement('div');
      slide.className = 'jd-slide' + (i === current ? ' active' : '');
      if (item.layout === 'diptych' && item.images) {
        slide.className += ' jd-diptych-slide';
        item.images.forEach(imgData => {
          const img = document.createElement('img');
          img.src = imgData.src; img.srcset = imgData.srcset;
          img.sizes = '(max-width: 768px) 100vw, 50vw';
          img.alt = imgData.alt || '';
          img.loading = (i === current || i === current + 1) ? 'eager' : 'lazy';
          img.onerror = () => { img.srcset = ''; img.src = imgData.full; };
          slide.appendChild(img);
        });
      } else {
        const img = document.createElement('img');
        img.src = item.src; img.srcset = item.srcset;
        img.sizes = '(max-width: 600px) 800px, (max-width: 1400px) 1600px, 3000px';
        img.alt = item.alt || '';
        img.loading = (i === current || i === current + 1) ? 'eager' : 'lazy';
        img.onerror = () => { img.srcset = ''; img.src = item.full; };
        slide.appendChild(img);
      }
      return slide;
    }

    data.forEach((item, i) => {
      const slide = createSlide(item, i);
      slideshow.appendChild(slide);
      slides.push(slide);
    });

    /* Filter */
    const filterContainer = document.getElementById('jd-filter-dropdown-container');
    const filterToggle = document.getElementById('jd-filter-toggle');
    const filterMenu = document.getElementById('jd-filter-menu');
    let uniqueSeries = [...new Set(data.map(item => item.series))].filter(s => s && s !== 'all');
    let currentFilter = 'all';
    let visibleIndices = data.map((_, i) => i);
    let visibleTotal = visibleIndices.length;

    if (uniqueSeries.length > 1 && filterContainer && isEventsCategory) {
      filterContainer.classList.add('is-visible');
      const btnAll = document.createElement('button');
      btnAll.className = 'jd-filter-btn active'; btnAll.textContent = meta.lang === 'fi' ? 'KAIKKI' : 'ALL';
      btnAll.dataset.filter = 'all'; filterMenu.appendChild(btnAll);
      uniqueSeries.forEach(s => {
        const btn = document.createElement('button');
        btn.className = 'jd-filter-btn'; btn.textContent = s.toUpperCase().replace(/-/g, ' ');
        btn.dataset.filter = s; filterMenu.appendChild(btn);
      });
      filterToggle.addEventListener('click', e => { e.stopPropagation(); filterMenu.classList.toggle('is-open'); filterToggle.classList.toggle('is-open'); });
      document.addEventListener('click', e => { if (!filterContainer.contains(e.target)) { filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); } });
      filterMenu.addEventListener('click', e => { if (e.target.tagName === 'BUTTON') { const f = e.target.dataset.filter; filterMenu.classList.remove('is-open'); filterToggle.classList.remove('is-open'); if (f !== currentFilter) applyFilter(f); } });
    }

    function applyFilter(filter) {
      currentFilter = filter;
      visibleIndices = [];
      data.forEach((item, i) => { if (filter === 'all' || item.series === filter) visibleIndices.push(i); });
      visibleTotal = visibleIndices.length;
      document.querySelectorAll('.jd-filter-btn').forEach(b => b.classList.toggle('active', b.dataset.filter === filter));
      let newCurrent = visibleIndices.includes(current) ? current : visibleIndices[0];
      if (newCurrent === undefined) newCurrent = 0;
      goToAbsolute(newCurrent, true);
    }

    /* Thumbs listeners */
    document.querySelectorAll('.jd-thumb-global').forEach(thumb => {
      thumb.addEventListener('click', () => {
        const cat = thumb.getAttribute('data-cat');
        const idx = parseInt(thumb.getAttribute('data-idx'), 10);
        const url = thumb.getAttribute('data-url');
        if (cat === categorySlug) { goToAbsolute(idx); closeThumbsView(); }
        else goToCategory(url);
      });
    });

    function updateCounter() {
      let vi = visibleIndices.indexOf(current);
      if (vi === -1) vi = 0;
      const n = vi + 1;
      if (document.getElementById('jd-counter-num')) document.getElementById('jd-counter-num').textContent = n;
      if (document.getElementById('jd-counter-tot')) document.getElementById('jd-counter-tot').textContent = visibleTotal;

      const cursorText = document.getElementById('jd-cursor-text');
      if (cursorText) cursorText.textContent = `${catLabel} — ${n} / ${visibleTotal}`;
    }
    updateCounter();

    /* Navigation */
    function goToCategory(url) {
      if (document.body.classList.contains('is-leaving')) return;
      if (thumbsOpen) closeThumbsView();
      document.body.classList.remove('is-entering-ready');
      document.body.classList.add('prepare-leave');
      void document.body.offsetWidth;
      document.body.classList.remove('prepare-leave');
      document.body.classList.add('is-leaving');
      let triggered = false;
      const handler = () => { triggered = true; window.location.href = url; };
      shutter.addEventListener('transitionend', handler, { once: true });
      setTimeout(() => { if (!triggered) window.location.href = url; }, 1600);
    }

    document.addEventListener('click', e => {
      const link = e.target.closest('a');
      if (link && link.href) {
        const urlObj = new URL(link.href, window.location.origin);
        if (urlObj.origin === window.location.origin && !link.hasAttribute('download') && link.target !== '_blank') {
          if (urlObj.pathname !== window.location.pathname || urlObj.search !== window.location.search) {
            e.preventDefault();
            if (typeof window.closeIndexPanel === 'function') window.closeIndexPanel();
            goToCategory(link.href);
          }
        }
      }
    });

    function goToRelative(step) {
      if (visibleTotal === 0) return;
      let cvi = visibleIndices.indexOf(current);
      if (cvi === -1) cvi = 0;
      const nvi = cvi + step;
      if (nvi >= 0 && nvi < visibleTotal) {
        goToAbsolute(visibleIndices[nvi]);
      } else if (nvi >= visibleTotal) {
        const nextUrl = document.getElementById('jd-next-url');
        if (nextUrl) goToCategory(nextUrl.textContent);
      } else {
        const prevUrl = document.getElementById('jd-prev-url');
        if (prevUrl) goToCategory(prevUrl.textContent);
      }
    }

    function goToAbsolute(idx, skipFilterCheck = false) {
      if (visibleTotal === 0) return;
      if (!skipFilterCheck && !visibleIndices.includes(idx)) applyFilter('all');
      if (slides[current]) slides[current].classList.remove('active');
      const localThumbs = document.querySelectorAll(`.jd-thumb-global[data-cat="${categorySlug}"]`);
      if (localThumbs[current]) localThumbs[current].classList.remove('is-active');
      current = idx;
      if (slides[current]) slides[current].classList.add('active');
      if (localThumbs[current]) localThumbs[current].classList.add('is-active');
      updateCounter();
      let vi = visibleIndices.indexOf(current);
      if (vi !== -1) {
        const ni = visibleIndices[(vi + 1) % visibleTotal];
        const pi = visibleIndices[(vi - 1 + visibleTotal) % visibleTotal];
        [ni, pi].forEach(ix => { const img = slides[ix] ? slides[ix].querySelector('img') : null; if (img && !img.complete) img.loading = 'eager'; });
      }
    }

    /* Touch */
    let touchStartX = 0, touchStartY = 0, hasSwiped = false, isDraggingMenu = false, menuCurrentDrag = 0;
    slideshow.addEventListener('touchstart', e => {
      touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY; hasSwiped = false;
      document.body.classList.add('user-has-interacted');
      if (!document.body.classList.contains('index-is-open') && window.innerWidth <= 800) {
        isDraggingMenu = true; menuCurrentDrag = 0;
        const panel = document.getElementById('jd-index-panel');
        if (panel) panel.style.setProperty('transition', 'none', 'important');
      }
    }, { passive: false });
    slideshow.addEventListener('touchmove', e => {
      const dx = Math.abs(e.touches[0].clientX - touchStartX);
      const dy = Math.abs(e.touches[0].clientY - touchStartY);
      if (!hasSwiped && (dx > 10 || dy > 10)) hasSwiped = true;
      if (isDraggingMenu) {
        const dragY = touchStartY - e.touches[0].clientY;
        if (dragY > 0) {
          menuCurrentDrag = dragY;
          const panel = document.getElementById('jd-index-panel');
          if (panel) panel.style.transform = `translateY(-${dragY}px)`;
          if (e.cancelable) e.preventDefault();
        }
      }
    }, { passive: false });
    slideshow.addEventListener('touchend', e => {
      const dx = e.changedTouches[0].clientX - touchStartX;
      if (Math.abs(dx) > 40 && !document.body.classList.contains('index-is-open') && !isDraggingMenu)
        dx < 0 ? goToRelative(1) : goToRelative(-1);
      if (isDraggingMenu) {
        isDraggingMenu = false;
        const panel = document.getElementById('jd-index-panel');
        if (panel) {
          panel.style.transition = '';
          if (menuCurrentDrag > window.innerHeight * 0.4) { panel.style.transform = ''; if (typeof window.openIndexPanel === 'function') window.openIndexPanel(); }
          else panel.style.transform = '';
        }
      }
    }, { passive: true });

    slideshow.addEventListener('click', e => {
      if (hasSwiped) { hasSwiped = false; return; }
      document.body.classList.add('user-has-interacted');
      if (thumbsOpen) return;
      e.clientX > window.innerWidth / 2 ? goToRelative(1) : goToRelative(-1);
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft' || e.key === ' ') document.body.classList.add('user-has-interacted');
      if (thumbsOpen && e.key === 'Escape') { closeThumbsView(); return; }
      if (e.key === 'ArrowRight' || e.key === ' ') { e.preventDefault(); goToRelative(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goToRelative(-1); }
    });

    /* Wheel to open/close index */
    let wheelDrag = 0, wheelDragTimer = null;
    window.addEventListener('wheel', e => {
      if (thumbsOpen || document.body.classList.contains('about-is-open')) return;
      if (window.innerWidth <= 800) return;
      const panel = document.getElementById('jd-index-panel');
      if (!panel) return;
      const isMenuOpen = document.body.classList.contains('index-is-open');
      if (!isMenuOpen) {
        if (e.deltaY > 0) {
          wheelDrag += Math.abs(e.deltaY);
          if (wheelDrag > window.innerHeight) wheelDrag = window.innerHeight;
          panel.style.transition = 'none'; panel.style.transform = `translateY(-${wheelDrag}px)`;
          clearTimeout(wheelDragTimer);
          wheelDragTimer = setTimeout(() => {
            panel.style.transition = '';
            if (wheelDrag > window.innerHeight * 0.20) { panel.style.transform = ''; if (typeof window.openIndexPanel === 'function') window.openIndexPanel(); }
            else panel.style.transform = '';
            wheelDrag = 0;
          }, 150);
        }
      } else {
        if (e.deltaY < 0 && panel.scrollTop <= 0) {
          wheelDrag += Math.abs(e.deltaY);
          panel.style.transition = 'none'; panel.style.transform = `translateY(calc(-100% + ${wheelDrag}px))`;
          clearTimeout(wheelDragTimer);
          wheelDragTimer = setTimeout(() => {
            panel.style.transition = '';
            if (wheelDrag > window.innerHeight * 0.20) { panel.style.transform = ''; if (typeof window.closeIndexPanel === 'function') window.closeIndexPanel(); }
            else panel.style.transform = '';
            wheelDrag = 0;
          }, 150);
          if (e.cancelable) e.preventDefault();
        } else { wheelDrag = 0; }
      }
    }, { passive: false });

    /* Cursor */
    if ('ontouchstart' in window) { if (cursor) cursor.style.display = 'none'; document.body.style.cursor = 'auto'; }
    if (!window.matchMedia('(pointer: coarse)').matches) {
      document.addEventListener('mousemove', e => {
        if (thumbsOpen) { cursor.style.opacity = '0'; document.body.style.cursor = 'auto'; return; }
        const target = e.target;
        const isNav = target.closest('#jd-bottom-nav') || target.closest('#jd-index-panel') || target.closest('#jd-thumbs-close');
        const nearBottom = e.clientY > window.innerHeight - 100;
        if (isNav || nearBottom) { cursor.style.opacity = '0'; document.body.style.cursor = 'auto'; }
        else {
          cursor.style.left = e.clientX + 'px'; cursor.style.top = e.clientY + 'px';
          sessionStorage.setItem('jdLastMouseX', e.clientX); sessionStorage.setItem('jdLastMouseY', e.clientY);
          cursor.style.opacity = '1'; document.body.style.cursor = 'none';
          const arrowEl = document.getElementById('jd-cursor-arrow');
          if (arrowEl) arrowEl.textContent = e.clientX > window.innerWidth / 2 ? '→' : '←';
        }
      });
      document.addEventListener('mouseleave', () => { cursor.style.opacity = '0'; });
    }

    /* Thumbs view */
    function openThumbsView() {
      thumbsOpen = true; thumbsPanel.classList.add('is-open');
      document.getElementById('jd-normal-nav').style.display = 'none';
      document.getElementById('jd-thumbs-nav').classList.add('is-open');
      const currentCatSection = document.getElementById(`jd-thumbs-section-${categorySlug}`);
      if (currentCatSection) {
        const currentThumb = currentCatSection.querySelectorAll('.jd-thumb-global')[current];
        if (currentThumb) { document.querySelectorAll('.jd-thumb-global.is-active').forEach(el => el.classList.remove('is-active')); currentThumb.classList.add('is-active'); }
        currentCatSection.scrollIntoView({ block: 'start', behavior: 'auto' });
      }
      const hintArrows = document.getElementById('jd-hint-arrows');
      if (hintArrows) hintArrows.style.opacity = '0';
    }
    function closeThumbsView() {
      thumbsOpen = false; thumbsPanel.classList.remove('is-open');
      document.getElementById('jd-normal-nav').style.display = 'flex';
      document.getElementById('jd-thumbs-nav').classList.remove('is-open');
    }
    document.getElementById('jd-thumbs-btn')?.addEventListener('click', openThumbsView);
    document.getElementById('jd-thumbs-close')?.addEventListener('click', closeThumbsView);

    /* Index button */
    document.getElementById('jd-index-btn-bottom')?.addEventListener('click', e => {
      e.stopPropagation();
      if (typeof window.openIndexPanel === 'function') {
        const panel = document.getElementById('jd-index-panel');
        panel?.classList.contains('is-open') ? window.closeIndexPanel() : window.openIndexPanel();
      }
    });

    /* Page entrance animation */
    function startPageOpen() {
      if (shutterTitle) {
        const isMobile = window.innerWidth <= 768;
        if (!isMobile) {
          const lastX = sessionStorage.getItem('jdLastMouseX');
          const lastY = sessionStorage.getItem('jdLastMouseY');
          if (lastX && lastY && cursor) { cursor.style.left = lastX + 'px'; cursor.style.top = lastY + 'px'; cursor.style.opacity = '1'; document.body.style.cursor = 'none'; }
        }
      }
      setTimeout(() => {
        document.body.classList.add('is-entering-ready');
        if (!sessionStorage.getItem('jd-hints-seen')) {
          const hintArrows = document.getElementById('jd-hint-arrows');
          if (hintArrows) hintArrows.classList.add('show-hints');
          sessionStorage.setItem('jd-hints-seen', 'true');
        }
      }, 50);
    }

    document.body.classList.add('show-shutter-title');
    let isLoaded = document.readyState === 'complete', isMinTimePassed = false, hasOpened = false;
    window.addEventListener('load', () => { isLoaded = true; tryOpen(); });
    setTimeout(() => { isMinTimePassed = true; tryOpen(); }, 1200);
    function tryOpen() { if (!hasOpened && isLoaded && isMinTimePassed) { hasOpened = true; startPageOpen(); } }
    setTimeout(() => { if (!hasOpened) { hasOpened = true; startPageOpen(); } }, 3000);

    /* Index panel open/close (global) */
    const indexPanel = document.getElementById('jd-index-panel');
    const indexOverlay = document.getElementById('jd-index-overlay');
    const jdMain = document.getElementById('jd-main');

    window.openIndexPanel = function() {
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.add('is-open'); }
      indexOverlay?.classList.add('is-open'); document.body.classList.add('index-is-open');
      if (indexPanel) indexPanel.scrollTop = 0;
    };
    window.closeIndexPanel = function() {
      if (indexPanel) { indexPanel.style.transition = ''; indexPanel.style.transform = ''; indexPanel.classList.remove('parallax-ready'); indexPanel.classList.remove('is-open'); }
      indexOverlay?.classList.remove('is-open'); document.body.classList.remove('index-is-open');
    };

    if (indexPanel) {
      let panelTouchStartY = 0, isDraggingPanel = false;
      indexPanel.addEventListener('touchstart', e => { if (indexPanel.scrollTop <= 0) { panelTouchStartY = e.touches[0].clientY; isDraggingPanel = true; indexPanel.style.transition = 'none'; } else isDraggingPanel = false; }, { passive: true });
      indexPanel.addEventListener('touchmove', e => { if (!isDraggingPanel) return; const dy = e.touches[0].clientY - panelTouchStartY; if (dy > 0) { indexPanel.style.transform = `translateY(calc(-100% + ${dy}px))`; if (e.cancelable) e.preventDefault(); } else indexPanel.style.transform = 'translateY(-100%)'; }, { passive: false });
      indexPanel.addEventListener('touchend', e => { if (!isDraggingPanel) return; isDraggingPanel = false; const dy = e.changedTouches[0].clientY - panelTouchStartY; if (dy > 120) window.closeIndexPanel(); else { indexPanel.style.transition = ''; indexPanel.style.transform = ''; } }, { passive: true });
    }

    window.openAboutPanel = function() { const p = document.getElementById('jd-about-panel'); if (p) { p.classList.add('is-open'); document.body.classList.add('about-is-open'); const n = document.getElementById('jd-normal-nav'); if (n) n.style.display = 'none'; } };
    window.closeAboutPanel = function() { const p = document.getElementById('jd-about-panel'); if (p) { p.classList.remove('is-open'); document.body.classList.remove('about-is-open'); const n = document.getElementById('jd-normal-nav'); const tp = document.getElementById('jd-thumbs-panel'); if (n && (!tp || !tp.classList.contains('is-open'))) n.style.display = 'flex'; } };

    indexOverlay?.addEventListener('click', () => window.closeIndexPanel());
    jdMain?.addEventListener('click', e => { if (e.target.closest('#jd-bottom-nav')) return; if (document.body.classList.contains('index-is-open')) window.closeIndexPanel(); });
    document.querySelectorAll('#jd-index-panel .jd-index-link.active').forEach(link => { link.addEventListener('click', e => { e.preventDefault(); window.closeIndexPanel(); }); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') { window.closeIndexPanel(); window.closeAboutPanel(); } });
  });
  </script>
</body>
</html>