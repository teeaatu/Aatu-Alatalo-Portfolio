    }
    .jd-map-dot-wrapper:hover .jd-map-dot { transform: scale(1.6); cursor: pointer; }
    
    .leaflet-tooltip.jd-map-tooltip {
      background: #ffffff;
      border: 1px solid rgba(0,0,0,0.08);
      box-shadow: 0 4px 10px rgba(0,0,0,0.05);
