---
import { ViewTransitions } from 'astro:transitions';
import Head from '../components/Head.astro';
import MobileHeader from '../components/MobileHeader.astro';
import Footer from '../components/Footer.astro';

const { title, description, lang = 'fi', activeNav, translationUrl } = Astro.props;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <Head title={title} description={description} lang={lang} activeNav={activeNav} translationUrl={translationUrl} />
  <ViewTransitions />
</head>
<body id="body" class={activeNav === 'index' ? 'index-page' : ''} ontouchstart="">

  <MobileHeader lang={lang} translationUrl={translationUrl} />

  <slot name="sidebar" />

  <main class="page-enter-animation">
    <slot />
    <Footer lang={lang} />
  </main>

  <div class="back-to-top" id="backToTop" aria-label="Takaisin ylös">
    <svg class="progress-ring" width="56" height="56">
      <circle class="progress-ring__circle" id="progressBar" stroke="currentColor" stroke-width="2" fill="transparent" r="25" cx="28" cy="28"/>
    </svg>
    <svg class="arrow-up" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="12" y1="19" x2="12" y2="5"></line>
      <polyline points="5 12 12 5 19 12"></polyline>
    </svg>
  </div>

  <script is:inline>
    // --- NATIVE ASTRO VIEW TRANSITION LIFECYCLE ---
    // Astro's View Transitions triggers `astro:page-load` instead of `DOMContentLoaded`
    document.addEventListener('astro:page-load', () => {
      const menuToggle = document.getElementById('menuToggle');
      const body = document.getElementById('body');
      
      if(menuToggle && !menuToggle.dataset.listenerAttached) {
          menuToggle.addEventListener('click', () => {
              body.classList.toggle('menu-open');
          });
          menuToggle.dataset.listenerAttached = 'true';
      }

      // Close menu on navigation
      document.querySelectorAll('aside a, .mobile-header a').forEach(link => {
        if(!link.dataset.listenerAttached) {
          link.addEventListener('click', function(e) {
            if (body.classList.contains('menu-open')) {
              if (e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
              body.classList.remove('menu-open');
            }
          });
          link.dataset.listenerAttached = 'true';
        }
      });

      // Skrollaus kontaktiin
      const contactBtn = document.getElementById('contactBtn');
      if(contactBtn && !contactBtn.dataset.listenerAttached) {
          contactBtn.addEventListener('click', (e) => {
            e.preventDefault();
            const contactSection = document.getElementById('contact');
            if(contactSection) {
                contactSection.scrollIntoView({ behavior: 'smooth' });
                body.classList.remove('menu-open');
            }
          });
          contactBtn.dataset.listenerAttached = 'true';
      }

      // --- MASONRY GRID ---
      // (Grid logic will be handled within grid components, but we keep the structure ready)

      // Back to top logiikka
      const backToTopBtn = document.getElementById('backToTop');
      const progressBar = document.getElementById('progressBar');
      const circumference = 157;

      const handleScroll = () => {
          const scrollTotal = document.documentElement.scrollHeight - window.innerHeight;
          const scrollPosition = window.scrollY;
          if (backToTopBtn) {
              backToTopBtn.style.display = scrollPosition > 300 ? 'flex' : 'none';
              const scrollPercentage = scrollTotal > 0 ? scrollPosition / scrollTotal : 0;
              const offset = circumference - (scrollPercentage * circumference);
              if (progressBar) progressBar.style.strokeDashoffset = offset;
          }
      };

      window.removeEventListener('scroll', handleScroll);
      window.addEventListener('scroll', handleScroll, { passive: true });

      if (backToTopBtn && !backToTopBtn.dataset.listenerAttached) {
          backToTopBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
          backToTopBtn.dataset.listenerAttached = 'true';
      }

      // Mobile Smart Sticky Header Logic
      const mobileHeader = document.getElementById('mobileHeader');
      if (mobileHeader) {
        let lastScrollTop = 0;
        const handleHeaderScroll = () => {
          const scrollTop = window.scrollY || document.documentElement.scrollTop;
          
          if (scrollTop > 0) {
            mobileHeader.classList.add('is-scrolled');
          } else {
            mobileHeader.classList.remove('is-scrolled');
          }
          
          if (scrollTop > lastScrollTop && scrollTop > 50) {
            mobileHeader.classList.add('header--hidden');
          } 
          else if (scrollTop < lastScrollTop) {
            mobileHeader.classList.remove('header--hidden');
          }
          
          lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
        };
        window.removeEventListener('scroll', handleHeaderScroll);
        window.addEventListener('scroll', handleHeaderScroll, { passive: true });
      }

    });
  </script>
</body>
</html>
