---
const { images, lang = 'fi' } = Astro.props;
---
<div class="overview-grid">
  {images.map((item, index) => {
    let finalAlt = "Portfolio Image";
    if (item.alt !== 'EMPTY_ALT' && item.alt !== '') {
      finalAlt = item.alt;
    } else if (item.title !== 'EMPTY_OTSIKKO' && item.title !== '') {
      let titleLocalized = "";
      if (lang === 'en') {
        titleLocalized = item.title.split(' / ')[0].trim();
        if (item.type === 'diptych') titleLocalized += ` - Part ${item.index}/2`;
      } else {
        titleLocalized = item.title.split(' / ').pop().trim();
        if (item.type === 'diptych') titleLocalized += ` - Osa ${item.index}/2`;
      }
      finalAlt = titleLocalized;
    }

    let orientationClass = 'is-standard';
    if (item.orientation === 'portrait') orientationClass = 'is-portrait';
    else if (item.orientation === 'landscape') orientationClass = 'is-landscape';

    const isLazyOverview = !(item.pinPriority !== 999 || item.isPinned || index < 6);

    return (
      <div class={`overview-item ${orientationClass} ${item.itemType === 'badge' ? 'badge-item' : ''}`}>
        {item.linkUrl !== 'none' && item.linkUrl !== '' ? (
          <a href={item.linkUrl} target="_blank" rel="noopener noreferrer" class="no-decoration external-link-wrapper">
            <div class="external-link-overlay">
              <svg viewBox="0 0 24 24" width="36" height="36" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line>
              </svg>
            </div>
            <img src={item.lqipB64 || item.pThumbMobile}
                 data-mobile={item.pThumbMobile}
                 data-desktop={item.pThumbDesktop}
                 alt={finalAlt}
                 width={item.width} height={item.height}
                 class="link-img js-blur-up"
                 loading={isLazyOverview ? "lazy" : "eager"} fetchpriority={isLazyOverview ? "auto" : "high"}
                 onerror={`this.onerror=null;this.src='${item.fullImgUrl}'; this.classList.add('is-loaded');`} draggable="false" oncontextmenu="return false;" />
            <div class="external-link-text">
              <span>{lang === 'en' ? item.linkTextEn : item.linkTextFi}</span>
              <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>
        ) : (
          <a href={item.fullImgUrl} class="no-decoration gallery-link-wrapper">
            <img src={item.lqipB64 || item.pThumbMobile}
                 data-mobile={item.pThumbMobile}
                 data-desktop={item.pThumbDesktop}
                 alt={finalAlt}
                 width={item.width} height={item.height}
                 class="gallery-img js-blur-up"
                 data-pswp-src={item.fullImgUrl}
                 loading={isLazyOverview ? "lazy" : "eager"} fetchpriority={isLazyOverview ? "auto" : "high"}
                 onerror={`this.onerror=null;this.src='${item.fullImgUrl}'; this.classList.add('is-loaded');`} draggable="false" oncontextmenu="return false;" />
          </a>
        )}
      </div>
    );
  })}
</div>
