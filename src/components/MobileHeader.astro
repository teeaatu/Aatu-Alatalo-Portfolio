---
const { lang = 'fi', translationUrl = null } = Astro.props;

const fiUrl = translationUrl && lang === 'fi' ? translationUrl : (lang === 'fi' ? '/en/' : '/');
const enUrl = translationUrl && lang === 'en' ? translationUrl : (lang === 'en' ? '/' : '/en/');
---
<header class="mobile-header" id="mobileHeader">
  <div class="lang-switcher-clean">
    <a href={fiUrl} class={lang === 'fi' ? "active" : ""} onclick="localStorage.setItem('langPref','fi')">FI</a>
    <span class="separator">/</span>
    <a href={enUrl} class={lang === 'en' ? "active" : ""} onclick="localStorage.setItem('langPref','en')">EN</a>
  </div>
  <a href="/" class="site-logo brand-logo-mobile no-decoration" style="font-family: 'Lora', serif;">
    <span class="logo-name" style="display: block; line-height: 1.2;">Aatu Alatalo</span>
    <span class="logo-sub" style="display: block; line-height: 1.2; color: var(--text-dimmed);">photographer</span>
  </a>
  <button class="menu-toggle" id="menuToggle" aria-label="Avaa valikko">
    <div class="hamburger"></div>
  </button>
</header>
